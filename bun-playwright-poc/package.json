{
  "name": "bun-cdp",
  "version": "1.0.0",
  "description": "Lightweight CDP (Chrome DevTools Protocol) driver for Bun - bypasses Playwright IPC incompatibility",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts"
  ],
  "scripts": {
    "test": "bun test",
    "test:legacy": "bun run test-integration.ts",
    "test:safety": "bun run test-safety.ts",
    "test:all": "bun test && bun run test-safety.ts",
    "install:browsers": "bun run scripts/install.ts"
  },
  "keywords": [
    "bun",
    "cdp",
    "chrome",
    "devtools",
    "protocol",
    "automation",
    "browser",
    "playwright-alternative",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poisontr33s/chthonic-archive.git",
    "directory": "bun-playwright-poc"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/bun": "latest",
    "playwright": "^1.48.0"
  }
}

    "session:corpus:classify": "bun run scripts/session-corpus.ts --classify",
    "session:corpus:stats": "bun run scripts/session-corpus.ts --stats",
    "session:corpus:watch": "bun run scripts/session-corpus.ts --watch",
    "session:corpus:mcp": "bun run scripts/corpus-mcp.ts",

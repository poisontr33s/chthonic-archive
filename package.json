{
  "name": "chthonic-archive-root",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pwsh -NoProfile -File scripts/gemini-cli-wrapper.ps1 -v || true",
    "audit": "bun audit --ignore GHSA-26pp-8wgv-hjvm --ignore GHSA-r5rp-j6wh-rvv4 --ignore GHSA-xpcf-pg52-r92g --ignore GHSA-xf4j-xp2r-rqqx --ignore GHSA-wmmm-f939-6g9c",
    "audit:full": "bun audit",
    "doctor": "bun run dumpster-dive/forge/extension-archaeology/doctor.ts",
    "verify": "pwsh -NoProfile -File scripts/run-extension-archaeology-tests.ps1",
    "bun:audit": "bun run scripts/bun-practices-audit.ts",
    "bun:audit:strict": "bun run scripts/bun-practices-audit.ts --strict",
    "web:dev": "bun run --cwd apps/chthonic-next dev",
    "web:build": "bun run --cwd apps/chthonic-next build",
    "web:start": "bun run --cwd apps/chthonic-next start",
    "web:typecheck": "bun run --cwd apps/chthonic-next typecheck",
    "ext:e2e": "bun run --cwd extensions/chthonic-archive test:e2e",
    "icons:surface:map": "uv run scripts/icon_surface_map.py",
    "icons:scaffold:audit": "uv run scripts/icon_scaffold_contract_audit.py",
    "theme:contrast:audit": "uv run scripts/theme_contrast_audit.py",
    "theme:contrast:audit:strict": "uv run scripts/theme_contrast_audit.py --min-ratio 4.5 --strict",
    "paths:naming:audit": "uv run scripts/path_naming_audit.py",
    "ext:kits:check": "bun run --cwd extensions/chthonic-archive insiders:kits:check && bun run --cwd extensions/chthonic-statusbar insiders:kits:check && bun run --cwd extensions/chthonic-mandala insiders:kits:check",
    "ext:package:insiders": "bun run --cwd extensions/chthonic-archive insiders:package && bun run --cwd extensions/chthonic-statusbar insiders:package && bun run --cwd extensions/chthonic-mandala insiders:package",
    "ext:sync:insiders": "pwsh -NoProfile -File scripts/insiders-sync.ps1",
    "ext:sync:insiders:quick": "pwsh -NoProfile -File scripts/insiders-sync.ps1 -Quick",
    "ext:sync:insiders:package": "pwsh -NoProfile -File scripts/insiders-sync.ps1 -Package",
    "ext:sync:insiders:full": "pwsh -NoProfile -File scripts/insiders-sync.ps1 -WithDts -Package",
    "uncensored:bench": "uv run scripts/benchmark_local_uncensored_lanes.py --include-qwen25",
    "uncensored:steward": "uv run scripts/uncensored_lane_steward.py",
    "uncensored:refresh": "bun run uncensored:bench && bun run uncensored:steward",
    "uncensored:serve:json": "pwsh -NoProfile -File scripts/serve_uncensored_lane.ps1 -Lane strict_json",
    "uncensored:serve:code": "pwsh -NoProfile -File scripts/serve_uncensored_lane.ps1 -Lane code",
    "uncensored:serve:unrestricted": "pwsh -NoProfile -File scripts/serve_uncensored_lane.ps1 -Lane unrestricted",
    "hf:rank": "bun run scripts/hf-model-ranker.ts",
    "cross:critique": "bun run scripts/cross-critique.ts",
    "artcop:vscode": "bun run scripts/vscode-art-cop.ts",
    "review:ai": "bun run hf:rank --limit 80 && bun run artcop:vscode --images-dir bun-playwright-poc --max-images 4 --no-llm",
    "bus:spec-enforcer": "bun run extensions/spec-enforcer/src/index.ts",
    "bus:spec-enforcer:once": "bun run extensions/spec-enforcer/src/index.ts --once",
    "reflex:guard": "uv run extensions/reflex-guard/.chthonic/reflex_guard.py --staged",
    "gemini": "pwsh -NoProfile -File scripts/gemini-cli-wrapper.ps1",
    "gemini:install": "bun add -D @google/gemini-cli@preview",
    "gemini:model:sync": "bun run scripts/gemini-model-router.ts sync --write",
    "gemini:repair": "pwsh -NoProfile -File scripts/gemini-cli-wrapper.ps1 -r",
    "gemini:update": "pwsh -NoProfile -File scripts/gemini-cli-wrapper.ps1 -u",
    "gemini:version": "pwsh -NoProfile -File scripts/gemini-cli-wrapper.ps1 -v",
    "biome:install": "bun add -D @biomejs/biome@latest",
    "biome:version": "bunx @biomejs/biome --version",
    "lint:shebang": "bun run scripts/shebang-guard.ts",
    "lint:shebang:staged": "bun run scripts/shebang-guard.ts --staged",
    "hooks:install": "pwsh -NoProfile -File scripts/install-hooks.ps1",
    "ci": "bun run ci/run.ts",
    "ci:staged": "bun run ci/run.ts --staged",
    "ci:full": "bun run ci/run.ts --full",
    "ci:check": "bun run ci/run.ts --check",
    "ci:list": "bun run ci/run.ts --list",
    "teleport": "bun run scripts/teleport.ts",
    "teleport:dry": "bun run scripts/teleport.ts --dry-run",
    "teleport:from:alchemy": "bun run scripts/teleport.ts --from \"C:\\Users\\eldno\\Dev_Active_WetPaperToDiamond\\alchemy\" --apply",
    "test": "bun test scripts/gemini-model-router.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@sentry/bun": "^10.49.0",
    "ajv": "^8.18.0",
    "hono": "^4.12.12",
    "minimatch": "^10.2.4"
  },
  "devDependencies": {
    "@davestewart/outliner": "^1.2.0",
    "@google/gemini-cli": "^0.38.2",
    "@playwright/mcp": "^0.0.70",
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "^16.0.0",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0"
  },
  "overrides": {
    "hono": "4.12.12",
    "@hono/node-server": "1.19.14",
    "@tootallnate/once": "3.0.1",
    "@xmldom/xmldom": "0.9.9",
    "ajv": "8.18.0",
    "brace-expansion": "5.0.5",
    "express-rate-limit": "8.3.1",
    "lodash": "4.18.1",
    "makerjs": "0.19.2",
    "minimatch": "10.2.4",
    "path-to-regexp": "8.4.2",
    "picomatch": "2.3.2",
    "undici": "7.24.4",
    "qs": "6.14.2"
  }
}

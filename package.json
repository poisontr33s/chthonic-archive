{
  "name": "chthonic-archive-root",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.3.13" },
  "scripts": {
    "postinstall": "pwsh -NoProfile -File scripts/gemini-cli-wrapper.ps1 -v || true",
    "audit": "bun audit --ignore GHSA-26pp-8wgv-hjvm --ignore GHSA-r5rp-j6wh-rvv4 --ignore GHSA-xpcf-pg52-r92g --ignore GHSA-xf4j-xp2r-rqqx --ignore GHSA-wmmm-f939-6g9c",
    "audit:full": "bun audit",

    "test:changed": "bun test --changed scripts/gemini-model-router.test.ts",
    "test:parallel": "bun test --parallel scripts/gemini-model-router.test.ts",
    "session:view": "bun run scripts/session-viewer.ts",
    "session:view:tail": "bun run scripts/session-viewer.ts --tail 40",
    "session:view:full": "bun run scripts/session-viewer.ts --tail 9999",
    "session:archive": "bun run scripts/session-viewer.ts --archive",
    "session:archive:closed": "bun run scripts/session-viewer.ts --archive --closed --no-open",
    "session:watch": "bun run scripts/session-watcher.ts",
    "session:watch:push": "bun run scripts/session-watcher.ts --push",
    "session:watch:once": "bun run scripts/session-watcher.ts --once",
    "session:index": "bun run scripts/session-index.ts",
    "session:search": "bun run scripts/session-index.ts --search",
    "session:failures": "bun run scripts/session-index.ts --failures",

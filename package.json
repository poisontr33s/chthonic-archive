    "todo:add": "bun run scripts/todo_roulette.ts --add",
    "todo:list": "bun run scripts/todo_roulette.ts --list",
    "todo:list:all": "bun run scripts/todo_roulette.ts --list --all",
    "todo:report": "bun run scripts/todo_roulette.ts --report",

* text=auto eol=lf

# Known binary (never normalize or treat as text)
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.pdf -text
*.zip -text
*.7z -text
*.gz -text
*.tar -text
*.bz2 -text
*.xz -text
*.mp4 -text
*.mov -text
*.mp3 -text
*.wav -text
*.ttf -text
*.otf -text
*.woff -text
*.woff2 -text
*.exe -text
*.dll -text
*.pyd -text
*.so -text
*.dylib -text
*.bin -text
*.safetensors -text
*.gguf -text

*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# cmd.exe batch files MUST be CRLF — LF-only causes "is not recognized as
# internal or external command" parser errors on every line. Used by
# scripts/git-chthonic.cmd (V1.5 shim, wired to VS Code's git.path).
*.cmd text eol=crlf
*.bat text eol=crlf

# Approved LFS lane for model adapter payloads that are ignored by default.
adapters/claudine-v1/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
adapters/claudine-v1/**/*.pt filter=lfs diff=lfs merge=lfs -text
adapters/claudine-v1/**/*.pth filter=lfs diff=lfs merge=lfs -text
adapters/claudine-v1/**/*.bin filter=lfs diff=lfs merge=lfs -text

# POC form-vector reference imagery (Disco-Elysium-class screenshots, ~4.5MB each
# for originals; ~3MB for 2K collages). Narrowly scoped to game/refs/pocNN/ —
# does NOT catch game/cocos-iso/library/*.png (Cocos Creator's auto-generated
# engine asset cache) or any other in-tree binaries.
game/refs/poc**/*.png filter=lfs diff=lfs merge=lfs -text
game/refs/poc**/*.webp filter=lfs diff=lfs merge=lfs -text
game/refs/poc**/*.jxl filter=lfs diff=lfs merge=lfs -text
game/refs/poc**/*.qoi filter=lfs diff=lfs merge=lfs -text

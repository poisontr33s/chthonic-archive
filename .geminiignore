# Gemini Ignore Rules
# This is a BLACKLIST - files listed here are ignored
# Everything NOT listed here is readable by Gemini CLI

# Standard noise - always ignore
node_modules/
.git/
.venv/
.codex/
*.log
*.tmp
*.bak

# Build artifacts
book/
dist/
target/
build/

# Archives & Dumpster
dumpster-dive/

# Credentials (safety)
.env
.env.*
gha-creds-*.json

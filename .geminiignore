# Gemini Ignore Rules
# This is a BLACKLIST - files listed here are ignored
# Everything NOT listed here is readable by Gemini CLI

# Standard noise - always ignore
node_modules/
.git/
.venv/
*.log
*.tmp
*.bak

# Codex directories (local and global) - NEVER read these in bulk
.codex/
../.codex/
**/sessions/
**/auth.json
**/models_cache.json

# Large binary/generated content
*.jsonl
*.pyc
__pycache__/

# Build artifacts
book/
dist/
target/
build/

# Archives & Dumpster
dumpster-dive/

# Credentials (safety)
.env
.env.*
gha-creds-*.json

# Gemini Ignore Rules
# This is a BLACKLIST - files listed here are ignored
# Everything NOT listed here is readable by Gemini CLI

# Standard noise - always ignore
node_modules/
.git/
.venv/
*.log
*.tmp
*.bak

# Codex directories (local and global)
# .codex/ # Allow traversal for skills
../.codex/
.codex/sessions/
.codex/auth.json
.codex/models_cache.json
**/sessions/
**/auth.json
**/models_cache.json

# Large binary/generated content
*.jsonl
*.pyc
__pycache__/

# Build artifacts
book/
dist/
target/
build/

# Archives & Dumpster
dumpster-dive/

# Windows phantom artifacts
NUL
$null

# Credentials (safety)
.env
.env.*
gha-creds-*.json

# Satellite live junctions (migrated from VS Code workspace files.exclude)
*-live/
pnk-live/
rmco-live/
csb-live/
git-dump-live/
pnk-lfh-live/
poisontr33s-live/
eoai-live/

      "lines": [
        "def slurp(path: Path) -> list[str]:",
        "    return path.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()"
      ]
    },
    {
      "id": 16,
      "kind": "text",
      "lines": [
        "def classify(line: str) -> str:",
        "    s = line.rstrip()",
        "    if not s.strip():",
        "        return \"blank\"",
        "    if RE_CMD.match(s):",
        "        return \"cmd\"",
        "    if RE_ACTION.match(s):",
        "        return \"action\"",
        "    if RE_DIV.match(s):",
        "        return \"div\"",
        "    return \"text\""
      ]
    },
    {
      "id": 17,
      "kind": "text",
      "lines": [
        "def extract_events(lines: list[str]) -> list[Event]:",
        "    events: list[Event] = []",
        "    cur: Event | None = None"
      ]
    },
    {
      "id": 18,
      "kind": "text",
      "lines": [
        "    def flush() -> None:",
        "        nonlocal cur",
        "        if not cur:",
        "            return",
        "        # Drop trivial empty events.",
        "        if any(ln.strip() for ln in cur.lines):",
        "            events.append(cur)",
        "        cur = None"
      ]
    },
    {
      "id": 19,
      "kind": "text",
      "lines": [
        "    for ln in lines:",
        "        t = classify(ln)",
        "        if t in (\"blank\", \"div\"):",
        "            flush()",
        "            continue",
        "        kind = \"text\"",
        "        if t == \"cmd\":",
        "            kind = \"cmd\"",
        "        elif t == \"action\":",
        "            kind = \"action\""
      ]

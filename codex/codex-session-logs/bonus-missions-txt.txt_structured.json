      "lines": [
        "        if cur and cur.kind == kind:",
        "            cur.lines.append(ln.rstrip())",
        "        else:",
        "            flush()",
        "            cur = Event(kind=kind, lines=[ln.rstrip()])",
        "    flush()",
        "    return events"
      ]

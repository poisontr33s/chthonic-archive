{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chthonic-archive.local/schemas/integration-manifest-v1.0.0.json",
  "title": "Codex Integration Manifest",
  "description": "Deployment lineage tracking for Timeline A integration of extracted Timeline E content",
  "type": "object",
  "required": [
    "manifest_version",
    "registry_ref",
    "ssot_reference",
    "deployments"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Semantic version of this manifest schema",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "example": "1.0.0"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of manifest initialization"
    },
    "registry_ref": {
      "type": "string",
      "description": "Path to DUMPSTER_DIVE_REGISTRY.json",
      "example": "DUMPSTER_DIVE_REGISTRY.json"
    },
    "ssot_reference": {
      "type": "object",
      "description": "Reference to governing SSOT document",
      "required": ["path", "hash", "hash_algorithm", "computed_date"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to SSOT from project root",
          "example": ".github/copilot-instructions.md"
        },
        "hash": {
          "type": "string",
          "description": "Cryptographic hash of SSOT at integration time",
          "pattern": "^[A-F0-9]{64}$",
          "example": "0A2D16D92E4379907649A07E16A41E748802921116F6083A3F81074B96167791"
        },
        "hash_algorithm": {
          "type": "string",
          "enum": ["SHA256"],
          "description": "Hash algorithm used"
        },
        "computed_date": {
          "type": "string",
          "format": "date",
          "description": "Date hash was computed (YYYY-MM-DD)"
        }
      }
    },
    "deployments": {
      "type": "array",
      "description": "Chronological list of all integration deployments",
      "items": {
        "$ref": "#/definitions/deployment"
      }
    }
  },
  "definitions": {
    "deployment": {
      "type": "object",
      "description": "Single deployment operation record",
      "required": [
        "deployment_id",
        "deployment_type",
        "timestamp",
        "operator",
        "files",
        "validation",
        "status"
      ],
      "properties": {
        "deployment_id": {
          "type": "string",
          "description": "Unique identifier for this deployment",
          "pattern": "^DEPLOY-\\d{3}-\\d{8}$",
          "example": "DEPLOY-001-20251224"
        },
        "deployment_type": {
          "type": "string",
          "enum": ["full", "staged-partial", "rollback", "hotfix"],
          "description": "Category of deployment operation"
        },
        "phase": {
          "type": "string",
          "description": "Integration phase identifier",
          "example": "Phase 1 - Timeline E Extraction"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of deployment execution"
        },
        "operator": {
          "type": "string",
          "description": "Identity of operator executing deployment",
          "example": "THE-SAVANT (User)"
        },
        "ssot_hash_at_deployment": {
          "type": "string",
          "description": "SSOT hash active during this deployment (for drift tracking)",
          "pattern": "^[A-F0-9]{64}$"
        },
        "files": {
          "type": "array",
          "description": "Files integrated in this deployment",
          "items": {
            "$ref": "#/definitions/file_record"
          }
        },
        "sections_impacted": {
          "type": "array",
          "description": "SSOT sections modified by this deployment",
          "items": {
            "type": "string",
            "example": "Section 4.4: Prime Faction Matriarchs"
          }
        },
        "validation": {
          "type": "object",
          "description": "Validation checkpoint results",
          "required": ["fa4_compliance", "cross_references", "registry_sync"],
          "properties": {
            "fa4_compliance": {
              "type": "string",
              "enum": ["PASSED", "FAILED", "PENDING"],
              "description": "FA⁴ (Architectonic Integrity) validation status"
            },
            "cross_references": {
              "type": "string",
              "enum": ["PASSED", "FAILED", "PENDING"],
              "description": "Cross-reference link validation"
            },
            "registry_sync": {
              "type": "string",
              "enum": ["PASSED", "FAILED", "PENDING"],
              "description": "Registry update synchronization status"
            },
            "lint_check": {
              "type": "string",
              "enum": ["PASSED", "WARNINGS", "FAILED"],
              "description": "Markdown/JSON linting status"
            },
            "notes": {
              "type": "string",
              "description": "Additional validation notes or warnings"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["completed", "in-progress", "rolled-back", "failed"],
          "description": "Current deployment status"
        },
        "rollback_checkpoint": {
          "type": "string",
          "description": "Git commit hash or state identifier for rollback",
          "pattern": "^[a-f0-9]{7,40}$|^PRE-DEPLOY-\\d{3}$",
          "example": "PRE-DEPLOY-001"
        },
        "completion_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when deployment finalized"
        },
        "duration_minutes": {
          "type": "number",
          "description": "Total time elapsed from start to completion",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "description": "Deployment notes, observations, or issues encountered"
        }
      }
    },
    "file_record": {
      "type": "object",
      "description": "Individual file integration record",
      "required": [
        "filename",
        "file_id",
        "source_path",
        "target_section",
        "file_hash",
        "word_count",
        "validation_status"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "description": "Base filename",
          "example": "CHARACTER_OPERATIONAL_SIGNATURES.md"
        },
        "file_id": {
          "type": "string",
          "description": "Unique identifier from registry",
          "pattern": "^FILE-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "example": "FILE-9f8e7d6c-5b4a-3210-fedc-ba9876543210"
        },
        "source_path": {
          "type": "string",
          "description": "Relative path from dumpster-dive/",
          "example": "forge/tempered/CHARACTER_OPERATIONAL_SIGNATURES.md"
        },
        "target_section": {
          "type": "string",
          "description": "SSOT section receiving this content",
          "example": "Section 4.5: Lesser Factions"
        },
        "file_hash": {
          "type": "string",
          "description": "SHA256 hash of file content at integration time",
          "pattern": "^[A-F0-9]{64}$"
        },
        "word_count": {
          "type": "integer",
          "description": "Total word count of integrated content",
          "minimum": 0,
          "example": 11637
        },
        "fa4_certification": {
          "type": "string",
          "enum": ["PASSED", "FAILED", "NOT_EVALUATED"],
          "description": "FA⁴ validation status for this file"
        },
        "validation_status": {
          "type": "string",
          "enum": ["passed", "failed", "pending"],
          "description": "Overall validation outcome"
        },
        "validation_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When validation completed"
        },
        "ssot_hash_embedded": {
          "type": "boolean",
          "description": "Whether SSOT hash frontmatter was added to file",
          "example": true
        },
        "integration_notes": {
          "type": "string",
          "description": "File-specific integration notes"
        }
      }
    }
  }
}

network:
  host: 127.0.0.1
  port: 5000
  disable_auth: true

logging:
  prompt: false
  generation: false

sampling:
  override_preset: "Null"

model:
  model_name: "Llama-3.1-8B-Instruct-exl2-8.0bpw"

{
  "name": "mas-mcp-dashboard",
  "version": "2.1.0",
  "type": "module",
  "description": "Bun-native Genesis Dashboard for MAS-MCP monitoring",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "api": "bun --hot run server.ts",
    "api:start": "bun run server.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "test": "bun test",
    "cycle": "bun run lib/activator.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "latest",
    "autoprefixer": "latest",
    "chart.js": "4.5.1",
    "next": "latest",
    "postcss": "latest",
    "react": "latest",
    "react-chartjs-2": "5.3.1",
    "react-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "author": "MAS-MCP",
  "license": "MIT"
}

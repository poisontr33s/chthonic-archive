{
  // ─────────────────────────────────────────────────────────────────────────────
  // SATELLITE ORBIT WORKSPACE — Chthonic Archive + PsychoNoir-Kontrapunkt
  //
  // Architecture: "Satellite Orbit" pattern
  //   - Each repo retains full gitological sovereignty (separate .git/, history,
  //     remotes, commit flow). Neither absorbs the other.
  //   - VS Code multi-root creates a contextual binding: Copilot, search, and
  //     the editor see both repos simultaneously without repo coupling.
  //   - Two-layer satellite access:
  //       folders[] use ../paths  → VS Code git engine resolves .git/ correctly
  //       scripts/mcp.json use junctions → process spawning via workspace-root
  //     NTFS junctions (pnk-live, rmco-live, csb-live, git-dump-live, pnk-lfh-live)
  //     are script/MCP access paths; VS Code's git does NOT follow junctions for
  //     repo discovery, so workspace folders must use direct ../traversal.
  //   - SATELLITE_REGISTRY.json is the machine-readable satellite map — the
  //     SSOT for which siblings are in orbit and their governance metadata.
  //   - teleport.ts --from-sibling <alias> resolves via the registry, making
  //     the discovery mechanism self-describing and extensible.
  //
  // Open this workspace: VS Code Insiders → File → Open Workspace from File
  // ─────────────────────────────────────────────────────────────────────────────
  "folders": [
    {
      "path": ".",
      "name": "⚡ chthonic-archive [primary]"
    },
    {
      "path": "../PsychoNoir-Kontrapunkt",
      "name": "🌀 PsychoNoir-Kontrapunkt [satellite]"
    },
    {
      "path": "../Restructure-MCP-Orchestration",
      "name": "🔧 Restructure-MCP-Orchestration [satellite]"
    },
    {
      "path": "../Claudine_Supreme-Polyglot-Git-Cli-Lsp-Repo-Clone-Engineering-Bun-Technique",
      "name": "🏴‍☠️ Claudine-Supreme-Polyglot [satellite]"
    },
    {
      "path": "../git-dump-lfs-holder-we-it-takes",
      "name": "📦 git-dump-lfs-holder [satellite]"
    },
    {
      "path": "../psychonoir-kontrapunkt-large-file-holder",
      "name": "📦 pnk-large-file-holder [satellite]"
    }
  ],
  "settings": {
    // Hide the junction alias from the chthonic-archive Explorer tree
    // (it's a live link, not repo content)
    "files.exclude": {
      "pnk-live": true,
      "rmco-live": true,
      "csb-live": true,
      "git-dump-live": true,
      "pnk-lfh-live": true
    },
    // Prevent file watcher from traversing NTFS junctions into satellite .git/ dirs
    // Without this, ReadDirectoryChangesW follows junctions and triggers git status polling
    "files.watcherExclude": {
      "pnk-live/**": true,
      "rmco-live/**": true,
      "csb-live/**": true,
      "git-dump-live/**": true,
      "pnk-lfh-live/**": true
    },
    // Belt-and-suspenders: stop git discovery walk from entering junction dirs
    "git.repositoryScanIgnoredFolders": ["pnk-live", "rmco-live", "csb-live", "git-dump-live", "pnk-lfh-live"],
    "git.repositoryScanMaxDepth": 0,
    // Search: include PNK satellite by default (both repos in Ctrl+Shift+F scope)
    "search.useIgnoreFiles": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/__pycache__": true,
      "**/dumpster-dive": true
    },
    // Copilot workspace context: both repo roots visible
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    // Git: satellites are in folders[] for search/Copilot context only — no parent scan.
    // Keep SCM quiet unless explicitly invoked; transcript siphons are manual tasks below.
    "git.autoRepositoryDetection": "subFolders",
    "git.openRepositoryInParentFolders": "never",
    "git.autorefresh": false,
    "git.autofetch": false,
    "git.autofetchPeriod": 180,
    "git.confirmSync": false,
    "git.decorations.enabled": false,
    "git.enableStatusBarSync": false,
    "git.showProgress": false,
    "git.statusLimit": 500,
    "git.untrackedChanges": "hidden",
    "git.countBadge": "tracked",
    "git.enableSmartCommit": true,
    "git.smartCommitChanges": "tracked",
    "git.suggestSmartCommit": false,
    "git.pullTags": false,
    "git.postCommitCommand": "sync",
    "git.commandsToLog": [],
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,
    "git.showActionButton": {
      "commit": true,
      "publish": false,
      "sync": false
    },
    "scm.diffDecorations": "none",
    "git.statusDecorationColors": false,
    // Suppress git SCM for ALL satellites — absolute paths required by VS Code
    "git.ignoredRepositories": [
      "C:\\Users\\eldno\\PsychoNoir-Kontrapunkt",
      "C:\\Users\\eldno\\Restructure-MCP-Orchestration",
      "C:\\Users\\eldno\\Claudine_Supreme-Polyglot-Git-Cli-Lsp-Repo-Clone-Engineering-Bun-Technique",
      "C:\\Users\\eldno\\git-dump-lfs-holder-we-it-takes",
      "C:\\Users\\eldno\\psychonoir-kontrapunkt-large-file-holder",
      "C:\\Users\\eldno\\.vscode-insiders\\agent-plugins\\github.com\\github\\copilot-plugins"
    ],
    "claudeCode.allowDangerouslySkipPermissions": true,
    "githubPullRequests.pullRequestDescription": "Copilot",
    "workbench.colorTheme": "Chthonic — Geological Core (Sister Ferrum Scoriae)"
  },
  "extensions": {
    "recommendations": [
      "github.copilot",
      "github.copilot-chat",
      "github.vscode-pull-request-github"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🌊 Claudine: Polyrepo Quick Descent",
        "type": "shell",
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/polyrepo-runner.ps1",
          "-Quick",
          "-NoFetch"
        ],
        "group": "test",
        "detail": "Quick sweep of all districts (git + typecheck only). Claudine Sin'claire MILFOLOGICAL flavor. ~22s."
      },
      {
        "label": "☥ Claudine: Polyrepo Full Descent + Manifest",
        "type": "shell",
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/polyrepo-runner.ps1",
          "-Report"
        ],
        "group": "test",
        "detail": "Full district sweep — all tributaries. Emits manifest/polyrepo_gate.json. All entropy flows back."
      },
      {
        "label": "📜 Session: View Transcript (latest, tail 40)",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-viewer.ts",
          "--tail",
          "40"
        ],
        "group": "test",
        "detail": "Renders latest Copilot Chat JSONL transcript to manifest/session_view.md and opens it in VS Code. Last 40 turns. Use --tail 9999 for full history."
      },
      {
        "label": "📜 Session: View Transcript (full session)",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-viewer.ts",
          "--tail",
          "9999"
        ],
        "group": "test",
        "detail": "Renders FULL latest Copilot Chat JSONL transcript to manifest/session_view.md and opens it in VS Code."
      },
      {
        "label": "👁️ Session: Watch + Push (siphon to GitHub)",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-watcher.ts",
          "--push"
        ],
        "group": "test",
        "isBackground": true,
        "presentation": {
          "reveal": "never",
          "panel": "dedicated",
          "clear": false
        },
        "detail": "Manual real-time siphon: AppData transcript writes → manifest/sessions/ → git commit → git push to GitHub. Auto-debounced 30s.",
        "problemMatcher": []
      },
      {
        "label": "👁️ Session: Watch (local mirror only)",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-watcher.ts"
        ],
        "group": "test",
        "isBackground": true,
        "presentation": {
          "reveal": "never",
          "panel": "dedicated",
          "clear": false
        },
        "detail": "Manual real-time mirror: watches AppData/.../transcripts/*.jsonl and copies every write to manifest/sessions/.",
        "problemMatcher": []
      },
      {
        "label": "📦 Session: Archive to repo (sync JSONL)",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-viewer.ts",
          "--archive"
        ],
        "group": "test",
        "detail": "Copies current session JSONL → manifest/sessions/<id>/transcript.jsonl. Writes meta.json. Updates sessions_index.json."
      },
      {
        "label": "📋 Session: List archives",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-index.ts"
        ],
        "group": "test",
        "detail": "Lists all archived sessions in manifest/sessions_index.json."
      },
      {
        "label": "🔍 Session: Search archives",
        "type": "shell",
        "command": "bun",
        "args": [
          "run",
          "${workspaceFolder:⚡ chthonic-archive [primary]}/scripts/session-index.ts",
          "--search",
          "${input:searchTerm}"
        ],
        "group": "test",
        "detail": "Grep term across all archived session transcripts.",
        "dependsOn": []
      }
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chthonic://game/dialogue/dialogue.schema.json",
  "title": "Chthonic Dialogue Graph",
  "description": "Schema for dialogue scenes, node transitions, conditions, and gameplay effects.",
  "type": "object",
  "required": ["scene_id", "participants", "entry_node", "nodes"],
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry_node": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label", "next"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "speaker", "lines"],
      "properties": {
        "id": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    }
  }
}

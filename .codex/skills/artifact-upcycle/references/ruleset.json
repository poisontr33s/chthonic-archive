{
  "potency_map": {
    ".py": 100, ".ts": 100, ".rs": 100, ".ps1": 90,
    ".md": 80, ".json": 70, ".toml": 70,
    ".txt": 50, ".csv": 40,
    ".log": 10, ".tmp": 0, ".bak": 0
  },
    "content_modifiers": {
      "structural": ["class ", "def ", "function ", "# SSOT", "@SID"],
      "structural_bonus": 10,
      "critical_bonus": 50,
  
    "noise": ["generated by", "auto-generated"],
    "noise_penalty": -20,
    "todo_penalty": -5
  },
  "thresholds": {
    "archive": 20
  },
  "header_exempt_extensions": [".json", ".toml", ".yaml", ".yml", ".lock"],
  "link_repair_extensions": [".md"],
  "todo_extensions": [".md", ".py", ".ts", ".rs", ".ps1", ".txt"],
  "action_priority": [
    "archive",
    "normalize_name",
    "add_header",
    "repair_links",
    "extract_todos"
  ],
  "safe_filenames": [
    "README.md", "LICENSE", "Makefile", "Dockerfile", "Gemfile", "SKILL.md", "POLICY.md"
  ]
}

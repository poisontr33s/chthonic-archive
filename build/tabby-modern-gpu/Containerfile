# SID: CONTAINERFILE_TABBY_MODERN_GPU_V2
# Gate: tabby-modern GPU stack on Python 3.14.4 / CUDA 12.8 / Linux x86_64
# FAF: docs/reference/FAF_TABBYAPI_PY314_GPU_INFERENCE_HOST.md
#
# Resolves:
#   G5  exllamav3 cp314-linux_x86_64 wheel — L4 (no source build needed)
#   G6  flash_attn source build — GCC path, no MSVC hell (faster than Win32)
#   G7  formatron escape-sequence cessation — patchable in-container
#   G4  exllamav2 cp314 — source build from repo (no cp314 wheel; wall is wheel, not code)
#       FAF v0.4 reframe: impossible_currently was wheel-scoped Win32 label.
#       Linux CUDA dev env: git clone v0.3.2 + uv pip install . --no-build-isolation
#       P-08 validates the source install. Expected: L1-L2 admitted.
#
# Build:
#   podman build --tag tabby-modern-gpu -f build/tabby-modern-gpu/Containerfile .
#
# Run (GPU passthrough via NVIDIA CDI):
#   podman run --rm --device nvidia.com/gpu=all tabby-modern-gpu
#
# Run (NVIDIA Workbench / nvidia-container-toolkit):
#   podman run --rm --security-opt=label=disable \
#     --hooks-dir=/usr/share/containers/oci/hooks.d/ \
#     tabby-modern-gpu

FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubi9

# --- System dependencies ---
# gcc/gcc-c++/libstdc++-devel already present in devel image; listed for explicitness
# ninja-build + cmake required by flash_attn's build system
# curl-minimal is pre-installed and conflicts with full curl — omit curl here
RUN dnf install -y --allowerasing \
        git \
        gcc \
        gcc-c++ \
        cmake \
        ninja-build \
        libstdc++-devel \
        python3-devel \
    && dnf clean all

# --- uv install ---
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# --- Python 3.14.4 via uv ---
RUN uv python install 3.14.4
ENV UV_PYTHON=3.14.4

# --- CUDA environment ---
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

WORKDIR /workspace

# --- Copy probe ladder and patches into container ---
COPY probes/python/ /workspace/probes/python/
COPY build/tabby-modern-gpu/patches/ /workspace/patches/

# --- Create manifest output directory ---
RUN mkdir -p /workspace/manifest

# --- Install GPU stack into a uv-managed venv ---
# Pass 1: torch + CUDA (pytorch-cu128 index)
RUN uv venv /workspace/.venv --python 3.14.4
ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="/workspace/.venv/bin:${PATH}"

RUN uv pip install \
        --index-url https://download.pytorch.org/whl/cu128 \
        "torch>=2.11.0"

# --- exllamav3 cp314 Linux wheel (G5 — direct URL, no source build) ---
RUN uv pip install --no-deps \
    "https://github.com/turboderp-org/exllamav3/releases/download/v0.0.30/exllamav3-0.0.30+cu128.torch2.11.0-cp314-cp314-linux_x86_64.whl"

# --- flash_attn (G6) ---
# DIAGNOSIS (2026-04-25): flash-attn 2.8.3 hardcodes its own arch list (sm_80/90/100/120)
# and ignores TORCH_CUDA_ARCH_LIST entirely. With CUDA 12.8 and the bundled CUTLASS
# that predates sm_100/120, nvcc fails on ALL .cu files simultaneously (ninja parallel
# failure — actual nvcc error is swallowed). Source kernel build is not viable on
# cp314 + torch 2.11 + CUDA 12.8 without patching flash-attn's setup.py arch list.
#
# RESOLUTION: FLASH_ATTENTION_SKIP_CUDA_BUILD=TRUE installs the Python layer only.
# flash_attn Python API is available; CUDA kernel (flash_attn_2_cuda) is not built.
# tabbyAPI checks: try: from flash_attn import flash_attn_func — if unavailable,
# falls back to torch native SDPA (GPU-accelerated via cuBLAS, not flash kernel).
# G6 gate status: python_only_admitted. CUDA kernel: source_build_failed_diagnosed.
#
# MAX_JOBS kept for exllamav2 build below (also uses ninja).
ENV MAX_JOBS=4
ENV FLASH_ATTENTION_SKIP_CUDA_BUILD=TRUE
RUN uv pip install packaging wheel
RUN uv pip install flash-attn==2.8.3 --no-build-isolation

# --- tabbyAPI core deps (pydantic, formatron, etc.) ---
# formatron pinned to known-working version per FAF Gate 7 membrane
# Replace <VERSION> with output of: pip show formatron | grep Version
# in the dev/tabbyAPI venv — or latest stable before cessation boundary
RUN uv pip install \
        "pydantic>=2.13.0,<3" \
        "pydantic-core>=2.46.0" \
        "formatron>=0.4.0,<1.0"

# --- Apply formatron escape-sequence patch (G7 membrane) ---
# Fixes \A, \z, \[ bare-string invalid escape sequences
# Safe to apply — r-prefix is semantically identical for regex strings
RUN python /workspace/patches/patch-formatron-escape.py

# --- G4: exllamav2 source build (Linux lane — no cp314 wheel, wall is wheel not code) ---
# FAF v0.4: impossible_currently was a wheel-scoped Win32 label.
# CUDA dev + GCC + cmake are already present in this image.
# exllamav2 source has no Python 3.14 barrier.
# --no-build-isolation shares already-installed torch headers.
# Expected build time: 5-15 min (smaller C++ surface than flash_attn).
RUN git clone --branch v0.3.2 --depth 1 \
        https://github.com/turboderp-org/exllamav2 \
        /build/exllamav2 \
    && cd /build/exllamav2 \
    && uv pip install . --no-build-isolation

# --- Run probe ladder ---
# Default CMD: P-08 (exllamav2 source build gate — G4 Linux path)
# Override with: podman run ... python /workspace/probes/python/P-07.py (G7)
CMD ["python", "/workspace/probes/python/P-08.py"]

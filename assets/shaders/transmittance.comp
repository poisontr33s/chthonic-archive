#version 450
#extension GL_ARB_separate_shader_objects : enable

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D u_transmittance_lut;

// Include the UBO definition here (matching the struct above)
layout(set = 1, binding = 0) uniform AtmosphereData {
    mat4 current_motion_view_projection;
    mat4 previous_motion_view_projection;
    vec4 sst_data;
    vec3  sun_direction;
    float bottom_radius;
    vec3  rayleigh_scattering;
    float top_radius;
    vec3  mie_scattering;
    float mie_extinction;
    vec3  ozone_absorption;
    float mie_g;
} u_atm;

const float SAMPLE_COUNT = 40.0;

// Ray-sphere intersection routine
// Returns distance to the intersection, or -1.0 if no hit.
float rayIntersectSphere(vec3 ro, vec3 rd, float rad) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - rad * rad;
    if (c > 0.0 && b > 0.0) return -1.0;
    float discr = b * b - c;
    if (discr < 0.0) return -1.0;
    // We want the forward intersection
    if (discr > 0.0) {
        float t = -b + sqrt(discr);
        if (t > 0.0) return t;
    }
    return -1.0;
}

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lut_size = imageSize(u_transmittance_lut);
    if (pixel_coords.x >= lut_size.x || pixel_coords.y >= lut_size.y) {
        return;
    }

    // Parameterize pixel coordinates to (r, mu)
    // x maps to mu (cosine of view zenith angle), y maps to altitude (r)
    vec2 uv = (vec2(pixel_coords) + 0.5) / vec2(lut_size);
    // Hillaire/Bruneton parameterization mapping UV back to physical bounds
    // Altitude r: mapped linearly from bottom_radius to top_radius for simplicity in V1
    float r = mix(u_atm.bottom_radius, u_atm.top_radius, uv.y);
    // View angle mu: mapped from -1.0 (straight down) to 1.0 (straight up)
    float mu = mix(-1.0, 1.0, uv.x);

    // Construct ray origin and direction
    vec3 ro = vec3(0.0, r, 0.0);
    vec3 rd = vec3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0); // sin(theta), cos(theta), 0

    // Find intersection with the top of the atmosphere
    float t_max = rayIntersectSphere(ro, rd, u_atm.top_radius);

    // If the ray hits the Earth first, the transmittance is effectively 0
    float t_earth = rayIntersectSphere(ro, rd, u_atm.bottom_radius);
    if (t_earth > 0.0) {
        imageStore(u_transmittance_lut, pixel_coords, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    // Numerical integration (Raymarching)
    float dt = t_max / SAMPLE_COUNT;
    float t = 0.5 * dt; // Start at half-step
    vec3 optical_depth_R = vec3(0.0);
    vec3 optical_depth_M = vec3(0.0);
    vec3 optical_depth_O = vec3(0.0); // Ozone

    // Scale heights for density falloff (km)
    const float H_R = 8.0;
    const float H_M = 1.2;

    for (int i = 0; i < int(SAMPLE_COUNT); ++i) {
        vec3 p = ro + rd * t;
        float height = length(p) - u_atm.bottom_radius;
        // Calculate atmospheric density at current height
        float rho_R = exp(-height / H_R);
        float rho_M = exp(-height / H_M);
        // Ozone distribution (peaks around 25km)
        float rho_O = max(0.0, 1.0 - abs(height - 25.0) / 15.0);

        optical_depth_R += u_atm.rayleigh_scattering * rho_R * dt;
        optical_depth_M += vec3(u_atm.mie_extinction) * rho_M * dt;
        optical_depth_O += u_atm.ozone_absorption * rho_O * dt;
        t += dt;
    }

    // Transmittance = exp(-total optical depth)
    vec3 transmittance = exp(-(optical_depth_R + optical_depth_M + optical_depth_O));
    imageStore(u_transmittance_lut, pixel_coords, vec4(transmittance, 1.0));
}

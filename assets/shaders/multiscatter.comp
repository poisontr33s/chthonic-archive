#version 450
#extension GL_ARB_separate_shader_objects : enable

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// The 32x32 output LUT
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D u_multiscatter_lut;

// The 256x64 Transmittance LUT from the previous pass
layout(set = 0, binding = 1) uniform sampler2D u_transmittance_lut;

layout(set = 1, binding = 0) uniform AtmosphereData {
    vec4  sst_data;
    vec3  sun_direction;
    float bottom_radius;
    vec3  rayleigh_scattering;
    float top_radius;
    vec3  mie_scattering;
    float mie_extinction;
    vec3  ozone_absorption;
    float mie_g;
} u_atm;

const float SPHERE_SAMPLES = 64.0; // Isotropic integration samples

// Utility: Sample the Transmittance LUT
vec3 getTransmittance(float r, float mu) {
    // Map r to [0, 1]
    float u_r = (r - u_atm.bottom_radius) / (u_atm.top_radius - u_atm.bottom_radius);
    // Map mu from [-1, 1] to [0, 1]
    float u_mu = mu * 0.5 + 0.5;    
    // Clamp to prevent edge bleeding
    u_r = clamp(u_r, 0.0, 1.0);
    u_mu = clamp(u_mu, 0.0, 1.0);    
    return texture(u_transmittance_lut, vec2(u_mu, u_r)).rgb;
}

// Ray-sphere intersection (same as transmittance.comp)
float rayIntersectSphere(vec3 ro, vec3 rd, float rad) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - rad * rad;
    if (c > 0.0 && b > 0.0) return -1.0;
    float discr = b * b - c;
    if (discr < 0.0) return -1.0;
    if (discr > 0.0) {
        float t = -b + sqrt(discr);
        if (t > 0.0) return t;
    }
    return -1.0;
}

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lut_size = imageSize(u_multiscatter_lut);    
    if (pixel_coords.x >= lut_size.x || pixel_coords.y >= lut_size.y) {
        return;
    }

    // Parameterize UVs
    vec2 uv = (vec2(pixel_coords) + 0.5) / vec2(lut_size);   
    // Map X to Sun Zenith Angle (mu_s)
    float mu_s = mix(-1.0, 1.0, uv.x);
    // Map Y to Altitude (r)
    float r = mix(u_atm.bottom_radius, u_atm.top_radius, uv.y);  

    vec3 sun_dir = vec3(sqrt(max(0.0, 1.0 - mu_s * mu_s)), mu_s, 0.0);
    vec3 ro = vec3(0.0, r, 0.0);

    // Isotropic integration setup
    vec3 lum_total = vec3(0.0);
    vec3 f_ms = vec3(0.0);

    // We integrate over a sphere of directions. For a basic implementation,
    // we trace rays in a uniform Fibonacci lattice or a simple loop.
    // For this blueprint, we use a simplified golden spiral spherical distribution.
    const float GOLDEN_RATIO = 1.61803398875;
    for(float i = 0.0; i < SPHERE_SAMPLES; i++) {
        float theta = acos(1.0 - 2.0 * (i + 0.5) / SPHERE_SAMPLES);
        float phi = 2.0 * 3.14159265 * i / GOLDEN_RATIO;
        vec3 rd = vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi));

        float t_max = rayIntersectSphere(ro, rd, u_atm.top_radius);
        float t_earth = rayIntersectSphere(ro, rd, u_atm.bottom_radius);
        if(t_earth > 0.0) t_max = min(t_max, t_earth);

        // Raymarch along rd to accumulate 2nd order scattering
        float dt = t_max / 20.0; // 20 steps for the inner integral is usually enough
        float t = 0.5 * dt;
        vec3 lum_ray = vec3(0.0);
        vec3 f_ms_ray = vec3(0.0);
        vec3 throughput = vec3(1.0);

        for(int j = 0; j < 20; j++) {
            vec3 p = ro + rd * t;
            float height = length(p) - u_atm.bottom_radius;
            float rho_R = exp(-height / 8.0);
            float rho_M = exp(-height / 1.2);
            float rho_O = max(0.0, 1.0 - abs(height - 25.0) / 15.0);

            vec3 scattering = u_atm.rayleigh_scattering * rho_R + u_atm.mie_scattering * rho_M;
            vec3 extinction = u_atm.rayleigh_scattering * rho_R + vec3(u_atm.mie_extinction) * rho_M + u_atm.ozone_absorption * rho_O;

            vec3 sample_transmittance = exp(-extinction * dt);

            // Sun transmittance to this point
            float p_mu_s = dot(p, sun_dir) / length(p);
            vec3 sun_trans = getTransmittance(length(p), p_mu_s);

            // Earth shadow check
            if (rayIntersectSphere(p, sun_dir, u_atm.bottom_radius) > 0.0) {
                sun_trans = vec3(0.0);
            }

            vec3 S = scattering * sun_trans; // Single scattering source
            lum_ray += throughput * S * dt;
            f_ms_ray += throughput * scattering * dt;
            throughput *= sample_transmittance;
            t += dt;
        }

        // Add to spherical integral (weight by sphere area / samples)
        lum_total += lum_ray;
        f_ms += f_ms_ray;
    }

    // Average out the spherical integration (divide by SPHERE_SAMPLES)
    lum_total /= SPHERE_SAMPLES;
    f_ms /= SPHERE_SAMPLES;
    
    // Apply the geometric series approximation: L_total = L_2nd / (1 - f_ms)
    vec3 multiscatter = lum_total / max(vec3(1.0) - f_ms, vec3(0.001));
    
    imageStore(u_multiscatter_lut, pixel_coords, vec4(multiscatter, 1.0));
}

// Rung 2.5 (RT reflections) — ray-generation stage. First cut: one reflection ray per water
// pixel, traced against the TLAS built in ray_tracing.rs (Phase 2: bathymetry + flat-rest-state
// ocean BLAS). Reads the water raster pass's outputs (normal_ws.rgba16f mask/normal, the
// existing depth image) rather than needing a parallel G-buffer system — set=1 mirrors
// water.frag/water.vert's existing FrameData descriptor set exactly (Phase 4 reuses
// Renderer::sst_desc_set directly instead of duplicating it).
#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT u_tlas;
layout(set = 0, binding = 1, rgba16f) uniform image2D u_rt_output;
layout(set = 0, binding = 2) uniform sampler2D u_normal_ws;
layout(set = 0, binding = 3) uniform sampler2D u_depth;

// Same buffer as water.frag/water.vert's FrameData (renderer.rs FrameUniform) — only the
// fields this stage needs are declared, at their true std140 offsets.
layout(set = 1, binding = 0, std140) uniform FrameData {
    mat4 current_motion_view_projection;
    layout(offset = 224) vec4 camera_pos_and_lens_flag;
} u_frame;

// .rgb = reflected color, .a = 1.0 on a real geometry hit / 0.0 on a sky miss — the Phase 5
// composite pass (water_reflection_composite.frag) blends by this alpha so a miss leaves the
// scene color bit-for-bit untouched. Written by water_reflection.rmiss/.rchit.
layout(location = 0) rayPayloadEXT vec4 hit_color;

// Independent review (2026-07-07) found reflections beyond this range silently truncate to
// sky under the Perspective lens (Isometric reflections are sub-pixel at ~740m/pixel, so it
// never mattered there) — named so the tradeoff is visible, not a magic number.
const float MAX_REFLECTION_DISTANCE = 10000.0;

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size  = ivec2(gl_LaunchSizeEXT.xy);

    vec4 normal_sample = texelFetch(u_normal_ws, pixel, 0);
    if (normal_sample.a < 0.5) {
        // Not a water pixel this frame. output_image is transitioned from UNDEFINED every
        // frame (Phase 5, renderer.rs) since every pixel is rewritten here — an early return
        // without writing would leave this texel's content undefined, and the composite pass
        // could read stale/garbage alpha as a false hit. Explicit miss-equivalent write instead.
        imageStore(u_rt_output, pixel, vec4(0.0));
        return;
    }
    vec3 N = normalize(normal_sample.xyz);

    // World-position reconstruction from depth (standard G-buffer technique) rather than a
    // second full-precision position attachment — the existing depth image already has
    // SAMPLED usage (renderer.rs create_depth_resources). current_motion_view_projection is
    // the UNJITTERED VP (see water.frag's motion-vector comment); gl_Position used the
    // jittered pc.projection*pc.view, so this reconstruction carries a sub-pixel jitter
    // offset — an accepted first-pass approximation, same spirit as the flat-mesh ocean BLAS.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float depth = texelFetch(u_depth, pixel, 0).r;
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = inverse(u_frame.current_motion_view_projection) * clip;
    world.xyz /= world.w;

    vec3 eye = u_frame.camera_pos_and_lens_flag.xyz;
    bool is_perspective = u_frame.camera_pos_and_lens_flag.w > 0.5;

    // Isometric is orthographic (parallel rays) — mirror water.frag's existing hardcoded
    // V = normalize(vec3(1,1,1)) rather than reconstructing a per-pixel origin that would be
    // meaningless under parallel projection. Perspective gets a true per-pixel view vector.
    vec3 V = is_perspective ? normalize(eye - world.xyz) : normalize(vec3(1.0, 1.0, 1.0));
    vec3 R = reflect(-V, N);

    hit_color = vec4(0.0);
    // cullMask 0x01 = bathymetry only (ray_tracing.rs instance masks). Excludes the ocean
    // BLAS (mask 0x02) — see ray_tracing.rs's instance-setup comment: tracing against the
    // flat rest-state ocean mesh produces self-hit speckle in wave troughs, so a ray that
    // would have hit ocean self-reflection correctly misses to sky instead for now.
    traceRayEXT(
        u_tlas, gl_RayFlagsOpaqueEXT, 0x01,
        0, 0, 0,              // sbtRecordOffset, sbtRecordStride, missIndex
        world.xyz + N * 0.05, // origin, offset along N to avoid self-intersection
        0.05,                 // tMin
        R,                    // direction
        MAX_REFLECTION_DISTANCE,
        0                      // payload location
    );

    imageStore(u_rt_output, pixel, hit_color);
}

#version 450
#extension GL_ARB_separate_shader_objects : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image3D u_base_noise;
layout(set = 0, binding = 1, rgba8) uniform writeonly image3D u_detail_noise;
layout(set = 0, binding = 2, r8)    uniform writeonly image2D u_coverage_map;

layout(push_constant) uniform PushConstants {
    int   target_pass; // 0=base 128^3, 1=detail 32^3, 2=coverage 512^2
    float scale;
} pc;

// ─── Hash ─────────────────────────────────────────────────────────────────────

vec3 hash3(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.xxy + p.yxx) * p.zyx);
}

vec2 hash2(vec2 p) {
    p = fract(p * vec2(0.1031, 0.1030));
    p += dot(p, p.yx + 33.33);
    return fract((p.xx + p.yx) * p.xy);
}

// ─── 3-D gradient (Perlin) noise → [0, 1] ────────────────────────────────────

float perlin3d(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    vec3 g000 = hash3(i + vec3(0,0,0)) * 2.0 - 1.0;
    vec3 g100 = hash3(i + vec3(1,0,0)) * 2.0 - 1.0;
    vec3 g010 = hash3(i + vec3(0,1,0)) * 2.0 - 1.0;
    vec3 g110 = hash3(i + vec3(1,1,0)) * 2.0 - 1.0;
    vec3 g001 = hash3(i + vec3(0,0,1)) * 2.0 - 1.0;
    vec3 g101 = hash3(i + vec3(1,0,1)) * 2.0 - 1.0;
    vec3 g011 = hash3(i + vec3(0,1,1)) * 2.0 - 1.0;
    vec3 g111 = hash3(i + vec3(1,1,1)) * 2.0 - 1.0;

    float v000 = dot(g000, f - vec3(0,0,0));
    float v100 = dot(g100, f - vec3(1,0,0));
    float v010 = dot(g010, f - vec3(0,1,0));
    float v110 = dot(g110, f - vec3(1,1,0));
    float v001 = dot(g001, f - vec3(0,0,1));
    float v101 = dot(g101, f - vec3(1,0,1));
    float v011 = dot(g011, f - vec3(0,1,1));
    float v111 = dot(g111, f - vec3(1,1,1));

    return mix(mix(mix(v000, v100, u.x), mix(v010, v110, u.x), u.y),
               mix(mix(v001, v101, u.x), mix(v011, v111, u.x), u.y), u.z)
           * 0.5 + 0.5; // [-0.5..0.5] → [0..1]
}

// ─── Worley (cellular) noise → [0=near feature, 1=far from feature] ──────────

float worley3d(vec3 p) {
    vec3 id = floor(p);
    vec3 fd = fract(p);
    float minDist = 1e10;
    for (int z = -1; z <= 1; z++)
    for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++) {
        vec3 offset = vec3(x, y, z);
        vec3 pt = hash3(id + offset) + offset;
        float d = length(pt - fd);
        minDist = min(minDist, d);
    }
    return clamp(minDist, 0.0, 1.0);
}

// ─── FBM wrappers ─────────────────────────────────────────────────────────────

float perlinFbm3d(vec3 uvw, float freq) {
    float val = 0.0, amp = 0.5, f = freq;
    for (int i = 0; i < 4; i++) {
        val += amp * perlin3d(uvw * f);
        f *= 2.0; amp *= 0.5;
    }
    // Max sum = 0.5+0.25+0.125+0.0625 = 0.9375; renormalize to [0,1]
    return clamp(val / 0.9375, 0.0, 1.0);
}

// Inverted: bright = cell centre (cloud bulk), dark = cell edge.
// Weights sum to exactly 1.0 → output stays in [0, 1].
float worleyFbm3d(vec3 uvw, float freq) {
    return clamp(
        (1.0 - worley3d(uvw * freq))       * 0.625 +
        (1.0 - worley3d(uvw * freq * 2.0)) * 0.25  +
        (1.0 - worley3d(uvw * freq * 4.0)) * 0.125,
        0.0, 1.0);
}

// ─── Nubis Perlin-Worley (base cloud shape) ───────────────────────────────────
// remap(perlin, 0, 1, worley, 1) = worley + perlin*(1-worley)
// Perlin provides macro shape; Worley breaks up the interior into cauliflower.

float remap01(float v, float lo, float hi) {
    return clamp((v - lo) / max(hi - lo, 1e-5), 0.0, 1.0);
}

float perlinWorley(vec3 uvw, float freq) {
    float p = perlinFbm3d(uvw, freq);
    float w = worleyFbm3d(uvw, freq);
    return clamp(w + p * (1.0 - w), 0.0, 1.0);
}

// ─── 2-D Perlin for coverage map ──────────────────────────────────────────────

float perlin2d(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float v00 = dot(hash2(i + vec2(0,0)) * 2.0 - 1.0, f - vec2(0,0));
    float v10 = dot(hash2(i + vec2(1,0)) * 2.0 - 1.0, f - vec2(1,0));
    float v01 = dot(hash2(i + vec2(0,1)) * 2.0 - 1.0, f - vec2(0,1));
    float v11 = dot(hash2(i + vec2(1,1)) * 2.0 - 1.0, f - vec2(1,1));
    return mix(mix(v00, v10, u.x), mix(v01, v11, u.x), u.y) * 0.5 + 0.5;
}

float perlinFbm2d(vec2 uv, float freq) {
    float val = 0.0, amp = 0.5, f = freq;
    for (int i = 0; i < 6; i++) {
        val += amp * perlin2d(uv * f);
        f *= 2.0; amp *= 0.5;
    }
    // Max sum = 1 - 0.5^6 = 0.984375; renormalize
    return clamp(val / 0.984375, 0.0, 1.0);
}

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    float s = pc.scale;

    if (pc.target_pass == 0) {
        ivec3 sz = imageSize(u_base_noise);
        if (any(greaterThanEqual(id, sz))) return;
        vec3 uvw = vec3(id) / vec3(sz);

        vec4 noise;
        noise.r = perlinWorley(uvw, 4.0 * s);   // base shape
        noise.g = worleyFbm3d(uvw,  8.0 * s);   // detail tier 1
        noise.b = worleyFbm3d(uvw, 16.0 * s);   // detail tier 2
        noise.a = worleyFbm3d(uvw, 32.0 * s);   // detail tier 3
        imageStore(u_base_noise, id, noise);

    } else if (pc.target_pass == 1) {
        ivec3 sz = imageSize(u_detail_noise);
        if (any(greaterThanEqual(id, sz))) return;
        vec3 uvw = vec3(id) / vec3(sz);

        vec4 noise = vec4(0.0, 0.0, 0.0, 1.0);
        noise.r = worleyFbm3d(uvw, 2.0 * s);
        noise.g = worleyFbm3d(uvw, 4.0 * s);
        noise.b = worleyFbm3d(uvw, 8.0 * s);
        imageStore(u_detail_noise, id, noise);

    } else if (pc.target_pass == 2) {
        ivec2 sz2 = imageSize(u_coverage_map);
        ivec2 id2 = id.xy;
        if (any(greaterThanEqual(id2, sz2))) return;
        vec2 uv = vec2(id2) / vec2(sz2);

        float coverage = perlinFbm2d(uv, 2.0 * s);
        // Bias toward partly-cloudy: remap [0.3, 0.8] → [0, 1]
        coverage = remap01(coverage, 0.3, 0.8);
        imageStore(u_coverage_map, id2, vec4(coverage, 0.0, 0.0, 1.0));
    }
}

#version 450
#extension GL_ARB_separate_shader_objects : enable
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Output: The 200x200 Sky View LUT
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D u_skyview_lut;
// Inputs from previous passes
layout(set = 0, binding = 1) uniform sampler2D u_transmittance_lut;
layout(set = 0, binding = 2) uniform sampler2D u_multiscatter_lut;

layout(set = 1, binding = 0) uniform AtmosphereData {
    mat4  current_motion_view_projection;
    mat4  previous_motion_view_projection;
    vec4  sst_data;
    vec3  sun_direction;
    float bottom_radius;
    vec3  rayleigh_scattering;
    float top_radius;
    vec3  mie_scattering;
    float mie_extinction;
    vec3  ozone_absorption;
    float mie_g;
} u_atm;

const float SAMPLE_COUNT = 30.0;

float rayleighPhase(float cos_theta) {
    return 3.0 / (16.0 * 3.14159265) * (1.0 + cos_theta * cos_theta);
}

float miePhase(float cos_theta, float g) {
    float g2 = g * g;
    float num = 3.0 * (1.0 - g2) * (1.0 + cos_theta * cos_theta);
    float den = 8.0 * 3.14159265 * (2.0 + g2) * pow(1.0 + g2 - 2.0 * g * cos_theta, 1.5);
    return num / den;
}

// Nearest positive root (entry point when ro is outside the sphere, exit
// point when inside). See multiscatter.comp for why the far-root version
// broke the earth-clip test below.
float rayIntersectSphere(vec3 ro, vec3 rd, float rad) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - rad * rad;
    if (c > 0.0 && b > 0.0) return -1.0;
    float discr = b * b - c;
    if (discr < 0.0) return -1.0;
    float sqrt_discr = sqrt(discr);
    float t0 = -b - sqrt_discr;
    float t1 = -b + sqrt_discr;
    if (t0 > 0.0) return t0;
    if (t1 > 0.0) return t1;
    return -1.0;
}

vec3 getTransmittance(float r, float mu) {
    float u_r = clamp((r - u_atm.bottom_radius) / (u_atm.top_radius - u_atm.bottom_radius), 0.0, 1.0);
    float u_mu = clamp(mu * 0.5 + 0.5, 0.0, 1.0);
    return texture(u_transmittance_lut, vec2(u_mu, u_r)).rgb;
}

vec3 getMultiScattering(float r, float mu_s) {
    float u_r = clamp((r - u_atm.bottom_radius) / (u_atm.top_radius - u_atm.bottom_radius), 0.0, 1.0);
    float u_mu_s = clamp(mu_s * 0.5 + 0.5, 0.0, 1.0);
    return texture(u_multiscatter_lut, vec2(u_mu_s, u_r)).rgb;
}

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lut_size = imageSize(u_skyview_lut);

    if (pixel_coords.x >= lut_size.x || pixel_coords.y >= lut_size.y) {
        return;
    }

    vec2 uv = (vec2(pixel_coords) + 0.5) / vec2(lut_size);

    float r = u_atm.bottom_radius + 1.0;

    // Non-linear parameterization: more pixels near the horizon
    float view_zenith_angle;
    if (uv.y < 0.5) {
        float coord = 1.0 - 2.0 * uv.y;
        view_zenith_angle = 3.14159265 * 0.5 + coord * coord * 3.14159265 * 0.5;
    } else {
        float coord = (uv.y - 0.5) * 2.0;
        view_zenith_angle = 3.14159265 * 0.5 - coord * coord * 3.14159265 * 0.5;
    }

    float light_view_angle = (uv.x * 2.0 - 1.0) * 3.14159265;

    float mu = cos(view_zenith_angle);
    vec3 ro = vec3(0.0, r, 0.0);
    vec3 rd = vec3(sin(view_zenith_angle) * cos(light_view_angle),
                   cos(view_zenith_angle),
                   sin(view_zenith_angle) * sin(light_view_angle));

    float t_max = rayIntersectSphere(ro, rd, u_atm.top_radius);
    float t_earth = rayIntersectSphere(ro, rd, u_atm.bottom_radius);
    if (t_earth > 0.0) {
        t_max = min(t_max, t_earth);
    }

    float dt = t_max / SAMPLE_COUNT;
    float t = 0.5 * dt;

    vec3 luminance = vec3(0.0);
    vec3 throughput = vec3(1.0);

    float cos_theta = dot(rd, normalize(u_atm.sun_direction));
    float phase_R = rayleighPhase(cos_theta);
    float phase_M = miePhase(cos_theta, u_atm.mie_g);

    for (float i = 0.0; i < SAMPLE_COUNT; i++) {
        vec3 p = ro + rd * t;
        float height = max(0.0, length(p) - u_atm.bottom_radius);

        float rho_R = exp(-height / 8.0);
        float rho_M = exp(-height / 1.2);
        float rho_O = max(0.0, 1.0 - abs(height - 25.0) / 15.0);

        vec3 scattering_R = u_atm.rayleigh_scattering * rho_R;
        vec3 scattering_M = u_atm.mie_scattering * rho_M;
        vec3 extinction = scattering_R + vec3(u_atm.mie_extinction) * rho_M + u_atm.ozone_absorption * rho_O;

        vec3 sample_transmittance = exp(-extinction * dt);

        float p_mu_s = dot(p, normalize(u_atm.sun_direction)) / length(p);
        vec3 sun_trans = getTransmittance(length(p), p_mu_s);
        if (rayIntersectSphere(p, normalize(u_atm.sun_direction), u_atm.bottom_radius) > 0.0) {
            sun_trans = vec3(0.0);
        }

        vec3 ms = getMultiScattering(length(p), p_mu_s);

        vec3 S_single = sun_trans * (scattering_R * phase_R + scattering_M * phase_M);
        vec3 S = S_single + (scattering_R + scattering_M) * ms;

        luminance += throughput * S * dt;
        throughput *= sample_transmittance;
        t += dt;
    }

    imageStore(u_skyview_lut, pixel_coords, vec4(luminance, 1.0));
}

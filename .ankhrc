# Ankh Resource Catalog (.ankhrc)
# Symbolic path resolver for SSOT references
# Prevents hardcoded filepath pollution in mythological documents
# Last Updated: 2026-01-25 (SSOT-ification Session)

[paths]
# Core Infrastructure
SSOT = ".github/copilot-instructions.md"
INSTRUCTION_DIR = ".github/instructions"
WORKFLOW_DIR = ".github/workflows"

# Instruction Files
DEV_CONVENTIONS = ".github/instructions/dev-conventions.md"
DCRP_GUIDE = ".github/instructions/dcrp-operational-guide.md"
AGENT_PROTOCOL = ".github/instructions/agent-priority-protocol.md"
ANKH_WORKFLOW = ".github/instructions/ankh-workflow.instructions.md"
PROJECT_WORKFLOW = ".github/instructions/project-workflow.instructions.md"
ASC_ENTITY_GENERATION = ".github/instructions/asc-entity-generation.instructions.md"
ASC_COMBINATIONAL_ANALYSIS = ".github/instructions/asc-combinational-analysis.md"
ASC_ENTITY_PROFILES = ".github/instructions/asc-entity-profiles.json"
ASC_GENERATIVE_RULES = ".github/instructions/asc-generative-rules-analysis.md"
ASC_VALIDATION_WORKFLOW = ".github/instructions/asc-entity-generation-validation-workflow.md"
ASC_HARDENING_REQUIREMENTS = ".github/instructions/asc-ml-framework-hardening-requirements.md"

# =============================================================================
# [ssot_ified] - Files SSOT-ified (derive constants from [SSOT](chthonic-archive/.github/copilot-instructions.md)
# Session: 2026-01-25
# =============================================================================
[ssot_ified]
SSOT_EXTRACTOR = "mas_mcp/ssot_extractor.py"
MILF_GENESIS_V2 = "mas_mcp/milf_genesis_v2.py"
ASC_TOOLCHAIN = "mas_mcp/lib/asc_toolchain.py"
# Deprecated v1 (archived)
MILF_GENESIS_V1_DEPRECATED = "dumpster-dive/forge/extension-archaeology/deprecated/milf_genesis_v1_deprecated.py"

# Scripts
SCRIPT_DIR = "scripts"
SSOT_HASH_SCRIPT = "scripts/ssot_hash_verify.py"
MAGISTRA_AUDIT = "scripts/magistra_audit.py"
MAGISTRA_VALIDATE = "scripts/magistra_validate.py"
MAGISTRA_SPECTRAL_TREND = "scripts/magistra_spectral_trend.py"
MAGISTRA_TREND_ANALYSIS = "scripts/magistra_trend_analysis.py"
DECORATOR_CROSS_REF = "scripts/decorator_cross_ref_maximum.py"
SHELL_CAPABILITIES = "scripts/shell_capabilities.ps1"
PAUSE_AGENTS = "scripts/pause_agents.ps1"

# Python Backend
MCP_DIR = "mas_mcp"
MCP_VENV = "mas_mcp/.venv"
MCP_SERVER = "mas_mcp/server.py"
MCP_PYPROJECT = "mas_mcp/pyproject.toml"
MCP_LOCKFILE = "mas_mcp/uv.lock"

# Dumpster Dive (MPW Canonical Sources)
DUMPSTER_DIR = "dumpster-dive"
MPW_DIR = "dumpster-dive/from-github/macro-prompt-world"
MPW_PRIME_FACTIONS = "dumpster-dive/from-github/macro-prompt-world/prime-factions"
MPW_SUB_MILFS = "dumpster-dive/from-github/macro-prompt-world/sub-milfs"
INTAKE_TEMPLATES = "dumpster-dive/intake/templates"
TRIUMVIRATE_TEMPLATE = "dumpster-dive/intake/templates/TRIUMVIRATE_TASK_TEMPLATE.md"

# Canonical Entity Documentation (MPW)
SPECTRA_CHROMA_DOC = "dumpster-dive/from-github/macro-prompt-world/sub-milfs/Spectra_Chroma_Excavatus_The_Chromatic_Archaeologist.md"
SNOW_WHITE_DOC = "dumpster-dive/from-github/macro-prompt-world/prime-factions/Alabaster_Voyde_The_Snow_White_Phenomenon.md"

# Artifacts & Indices
# Indices (relocated 2026-01-25 Stage 1.5 → data/indices/)
ANKH_INDEX = "data/indices/ankh_index.json"
SID_INDEX = "data/indices/sid_index.json"
# Reorganized: 2026-01-25 Stage 1.5 → data/
CURRICULUM_CORE = "data/curriculum_core_v1.json"
DEPENDENCY_GRAPH = "data/graphs/dependency_graph.json"
DEPENDENCY_GRAPH_PROD = "data/graphs/dependency_graph_production.json"
DEPENDENCY_GRAPH_ENHANCED = "data/graphs/dependency_graph_enhanced.json"
TOPOLOGY_GRAPH = "data/graphs/topology_graph.json"

# Documentation (relocated 2026-01-25 Stage 1.5)
CROSS_REF_TRIPTYCH = "docs/protocols/CROSS_REFERENCE_TRIPTYCH.md"
EPISTEMOGRAPH_CUSTODY = "docs/reference/epistemograph/epistemograph_custody_v1.1.1.md"
TOPOLOGY_MAP = "docs/architecture/topology_map.md"

# Runtime Artifacts (ephemeral)
MAGISTRA_SPECTRAL_HISTORY = ".magistra_spectral_history.json"
MAGISTRA_AUDIT_HISTORY = ".magistra_audit_history.json"
MAGISTRA_ERROR_LOG = ".magistra_error_log.json"
EMERGENCY_SEAL = ".EMERGENCY_SEAL"

# =============================================================================
# [state_files] - Runtime/persistent state artifacts
# Reorganized: 2026-01-25 Stage 1.5 → data/state/
# =============================================================================
[state_files]
DCRP_STATE = "data/state/.dcrp_state.json"
DCRP_EVOLUTION = "data/state/.dcrp_evolution.json"

# =============================================================================
# [databases] - SQLite and persistent stores
# Reorganized: 2026-01-25 Stage 1.5 → data/epistemograph/
# =============================================================================
[databases]
EPISTEMOGRAPH_DB_CURRENT = "data/epistemograph/chthonic_epistemograph_v1.1.1.sqlite"
EPISTEMOGRAPH_DB_LEGACY = "data/epistemograph/archive/chthonic_epistemograph_v1.1.sqlite"
EPISTEMOGRAPH_DB_ORIGINAL = "data/epistemograph/archive/chthonic_epistemograph.sqlite"
EPISTEMOGRAPH_TEST = "scripts/test_epistemograph.sqlite"

# =============================================================================
# [session_reports] - Session documentation ARCHIVED to docs/sessions/
# Migration: 2026-01-25 | Status: ARCHIVED
# =============================================================================
[session_reports]
SESSION_2026_01_01 = "docs/sessions/AUTONOMOUS_SESSION_2026-01-01.md"
SESSION_2_COMPLETE = "docs/sessions/AUTONOMOUS_SESSION_2_COMPLETE.md"
SESSION_3_COMPLETE = "docs/sessions/AUTONOMOUS_SESSION_3_COMPLETE.md"

# .ankhrc — Bidirectional SSOT Hub
# Canonical navigation index for the Chthonic Archive cascade.
# Maps symbolic names to SSOT-relative paths, tracks migration status.
#
# @SID: CONFIG_ANKHRC_V1
# @Type: INFRASTRUCTURE
# @Spectrum: WHITE
# @Zone: THE GARDEN
#
# Source of truth for path mappings: mas_mcp/logic/ssot_manifest.py (CASCADE_REGISTER)
# If paths change, update the manifest first, then sync this file.

# ── Core SSOT Files ──────────────────────────────────────────────────────────
[paths]
SSOT_HOLDER   = ".github/copilot-instructions.archive.md"
SSOT_POINTER  = ".github/copilot-instructions.md"
SSOT_PROTO    = ".github/copilot-instructions-copy.md"

# ── Cascade Infrastructure ───────────────────────────────────────────────────
[cascade]
MANIFEST       = "mas_mcp/logic/ssot_manifest.py"
BINDING        = "mas_mcp/logic/ssot_binding.py"
BINDING_TESTS  = "mas_mcp/tests/test_ssot_binding.py"
HASH_JOURNAL   = ".mas_mcp/ssot_hash_journal.jsonl"

# ── Bridges (cross-language SSOT path re-exports) ────────────────────────────
[bridges]
PYTHON         = "scripts/lib/ssot_paths.py"
TYPESCRIPT     = "scripts/lib/ssot-paths.ts"
POWERSHELL     = "scripts/lib/ssot-paths.ps1"
EXTENSION      = "extensions/chthonic-archive/src/ssot-paths.ts"
ASC_INJECTOR   = "scripts/mcp-asc-injector.ts"

# ── Projections (derived readable/navigable forms) ───────────────────────────
[projections]
READABLE_SSOT       = "scripts/generate_readable_ssot.py"
STRUCTURAL_EXTRACT  = "scripts/ssot_structural_extractor.py"
LOREMASTER          = "scripts/ssot_loremaster.py"
SSOT_EXTRACTOR      = "mas_mcp/ssot_extractor.py"
ABBREVIATION_CLI    = "mas_mcp/abbreviation_system/cli.py"

# ── Validators (integrity checks) ────────────────────────────────────────────
[validators]
NARRATIVE_SCAN = "scripts/run_narrative_scan.py"
RUN_CYCLE      = "scripts/run_cycle.py"

# ── Config Boundaries (IDE endpoints — literals required, manual sync) ───────
[config_boundaries]
VSCODE_MCP      = ".vscode/mcp.json"
VSCODE_SETTINGS = ".vscode/settings.json"

# ── State Files ──────────────────────────────────────────────────────────────
[state_files]
DCRP_STATE          = ".dcrp_state.json"
FORGE_PATHWAY_REG   = "dumpster-dive/forge/PATHWAY_REGISTRY.json"

# ── SSOT-ified Files (migrated to cascade imports) ───────────────────────────
[ssot_ified]
# Python consumers (Phase 0.2 — 16 scripts wired)
ANKH_THEME_REF          = "scripts/ankh_theme_reference.py"
ASC_ENTITY_GEN          = "scripts/asc_entity_generator.py"
BACKGROUND_SERVICES     = "scripts/background_services.py"
DECORATOR_CROSS_REF_ENH = "scripts/decorator_cross_ref_enhanced.py"
DECORATOR_CROSS_REF_MAX = "scripts/decorator_cross_ref_maximum.py"
DECORATOR_CROSS_REF_PRD = "scripts/decorator_cross_ref_production.py"
GENERATE_READABLE       = "scripts/generate_readable_ssot.py"
RUN_CYCLE_PY            = "scripts/run_cycle.py"
RUN_NARRATIVE           = "scripts/run_narrative_scan.py"
SCAN_REDUNDANCY         = "scripts/scan_redundancy.py"
SFA_CROSS_REF           = "scripts/sfa_cross_reference.py"
SSOT_LOREMASTER_PY      = "scripts/ssot_loremaster.py"
SSOT_STRUCTURAL_EXT     = "scripts/ssot_structural_extractor.py"
SYNTHESIS_CROSS_REF     = "scripts/synthesis_cross_reference.py"

# TypeScript consumers (Phase 0.3 — 6 files wired)
CROSS_CRITIQUE          = "scripts/cross-critique.ts"
MCP_ASC_INJECTOR        = "scripts/mcp-asc-injector.ts"
MCP_CHTHONIC_SERVER     = "scripts/mcp-chthonic-server.ts"
OVERNIGHT_DAEMON        = "scripts/overnight_daemon.ts"
EXT_EXTENSION           = "extensions/chthonic-archive/src/extension.ts"
EXT_ANKH_REF_VIEW       = "extensions/chthonic-archive/src/monolith/ankhReferenceView.ts"

# PowerShell consumers (Phase 0.4 — 4 files wired)
SSOT_REGISTRY_QUERY     = "scripts/ssot_registry_query_v2.ps1"
SSOT_OUTLINE_EXTRACTOR  = "scripts/ssot_outline_extractor.ps1"
SSOT_ACRONYM_AUDIT      = "scripts/ssot_acronym_audit.ps1"
NOVIA_EMBALMER          = "scripts/novia_cadaveris_embalmer.ps1"

# Phase 0.9 additions (register expansion 20 → 28)
SSOT_HASH               = "scripts/ssot_hash.py"
SSOT_IMMUNITY            = "scripts/ssot_immunity.py"
CHECK_PYTHON_POLICY      = "scripts/check_python_policy.py"

# ── Migration Status ─────────────────────────────────────────────────────────
[migration_status]
python_scripts    = "COMPLETE"    # Phase 0.2 — 16/16 wired
typescript_files  = "COMPLETE"    # Phase 0.3 — 6/6 wired
powershell_files  = "COMPLETE"    # Phase 0.4 — 4/4 wired (+ 2 comment-only exempt)
config_boundary   = "DOCUMENTED"  # Phase 0.5 — 2 IDE configs registered as boundaries
documentation     = "COMPLETE"    # Phase 0.6 — .ankhrc created, methodology updated
root_hygiene      = "COMPLETE"    # Phase 0.7 — 12 artifacts → dumpster-dive/intake/root-hygiene-0.7/
cascade_testing   = "COMPLETE"    # Phase 0.8 — 21/21 tests passing
register_expand   = "COMPLETE"    # Phase 0.9 — 20 → 28 entries (8 added)

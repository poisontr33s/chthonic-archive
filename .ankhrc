# =============================================================================
# [frameworks] - Framework/quickref docs ARCHIVED to docs/frameworks/
# Migration: 2026-01-25 | Status: ARCHIVED
# =============================================================================
[frameworks]
COORDINATOR_QUICKREF = "docs/frameworks/AUTONOMOUS_COORDINATOR_QUICKREF.md"
ORCHESTRATION_FRAMEWORK = "docs/frameworks/AUTONOMOUS_ORCHESTRATION_FRAMEWORK.md"

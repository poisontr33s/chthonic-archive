# =============================================================================
# [dcrp_reports] - DCRP analysis files CONSOLIDATED → docs/DCRP_SYNTHESIS.md
# Migration: 2026-01-25 | Status: CONSOLIDATED
# Originals archived to: dumpster-dive/consolidated/dcrp/
# =============================================================================
[dcrp_reports]
# SYNTHESIZED OUTPUT (active reference)
DCRP_SYNTHESIS = "docs/DCRP_SYNTHESIS.md"
# ARCHIVED ORIGINALS (historical reference only)
DCRP_DEPLOYMENT_SUMMARY_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_DEPLOYMENT_SUMMARY.md"
DCRP_ENHANCED_ANALYSIS_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_ENHANCED_ANALYSIS.md"
DCRP_FINAL_STATUS_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_FINAL_STATUS.md"
DCRP_MERGE_REPORT_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_MERGE_REPORT.txt"
DCRP_OBSERVABILITY_UPGRADE_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_OBSERVABILITY_UPGRADE.md"
DCRP_OBSERVABILITY_VALIDATION_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_OBSERVABILITY_VALIDATION_COMPLETE.md"
DCRP_PRODUCTION_ANALYSIS_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_PRODUCTION_ANALYSIS.md"
DCRP_REFACTOR_COMPLETE_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_REFACTOR_COMPLETE.md"
DCRP_REFACTORING_SESSION_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_REFACTORING_SESSION_SUMMARY.md"
DCRP_UNIFIED_REFACTOR_ARCHIVED = "dumpster-dive/consolidated/dcrp/DCRP_UNIFIED_REFACTOR.md"

# Rust/Vulkan
SRC_DIR = "src"
MAIN_RS = "src/main.rs"
CARGO_TOML = "Cargo.toml"

[anchors]
# Symbolic anchors for SSOT references (use these instead of raw paths)
# Format: $ANCHOR_NAME → resolves to paths[key] or section[key]

# Core SSOT Resolution Examples:
# "See $DEV_CONVENTIONS for runtime commands" → ".github/instructions/dev-conventions.md"
# "$MAGISTRA_AUDIT script" → "scripts/magistra_audit.py"
# "$TRIUMVIRATE_TEMPLATE encodes protocol" → "dumpster-dive/intake/templates/TRIUMVIRATE_TASK_TEMPLATE.md"

# SSOT-ified Module Resolution (2026-01-25):
# "$SSOT_EXTRACTOR provides get_ssot_constants()" → "mas_mcp/ssot_extractor.py"
# "$MILF_GENESIS_V2 uses Schema 2.0.0-SSOT" → "mas_mcp/milf_genesis_v2.py"

# =============================================================================
# [migration_status] - Stage 1 Repurposing Tracking
# Actions: ARCHIVED | CONSOLIDATED | KEEP | REGISTERED
# Updated: 2026-01-25
# =============================================================================
[migration_status]
# REGISTERED (newly tracked this session)
ssot_extractor = "REGISTERED"
milf_genesis_v2 = "REGISTERED"
asc_toolchain = "REGISTERED"
ssotification_methodology = "REGISTERED"
dcrp_synthesis = "REGISTERED"
stage1_migration_plan = "REGISTERED"

# ARCHIVED (moved to docs/ subdirectories)
session_reports = "ARCHIVED"
frameworks = "ARCHIVED"
handoffs = "ARCHIVED"

# CONSOLIDATED (merged into synthesis doc)
dcrp_reports = "CONSOLIDATED"

# KEEP (essential root files)
SSOT = "KEEP"
SID_INDEX = "KEEP"
CARGO_TOML = "KEEP"
ANKHRC = "KEEP"

# OUTPUT (logs)

TERMINAL = ".ankh.debug.health.log"
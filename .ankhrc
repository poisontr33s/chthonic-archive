SESSION_3_DEEP_RESEARCH = "docs/sessions/AUTONOMOUS_SESSION_3_DEEP_RESEARCH.md"
SESSION_3_EXECUTION = "docs/sessions/AUTONOMOUS_SESSION_3_EXECUTION_COMPLETE.md"
SESSION_3_MISSION_COMPLETE = "docs/sessions/AUTONOMOUS_SESSION_3_MISSION_COMPLETE.md"
SESSION_3_MISSION_REPORT = "docs/sessions/AUTONOMOUS_SESSION_3_MISSION_REPORT.md"
SESSION_4_COMPLETE = "docs/sessions/AUTONOMOUS_SESSION_4_COMPLETE.md"
SESSION_5_COMPLETE = "docs/sessions/AUTONOMOUS_SESSION_5_COMPLETE.md"
SESSION_5_MISSION_REPORT = "docs/sessions/AUTONOMOUS_SESSION_5_MISSION_REPORT.md"
SESSION_7_COMPLETE = "docs/sessions/AUTONOMOUS_SESSION_7_COMPLETE.md"
SESSION_STATUS = "docs/sessions/AUTONOMOUS_SESSION_STATUS.md"
SESSION_EPISTEMOGRAPH = "docs/sessions/SESSION_2026_01_04_EPISTEMOGRAPH_COMPLETE.md"

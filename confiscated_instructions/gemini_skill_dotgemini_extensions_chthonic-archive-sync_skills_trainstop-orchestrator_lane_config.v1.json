{
  "schema_version": 1,
  "artifact_dir": "codex/mailbox",
  "clean_exit_codes": [0],
  "lanes": {
    "maintenance": {
      "description": "Core repo hygiene (Train Stop classic).",
      "steps": [
        "skill_freshness_gate_codex",
        "api_manager_doctor",
        "toolchain_doctor",
        "skill_polisher_codex",
        "skill_polisher_claude",
        "mailbox_polisher_codex",
        "mailbox_polisher_claude",
        "mailbox_scribe_codex",
        "mailbox_scribe_claude",
        "mailbox_manifest_check"
      ]
    },
    "mcp-auth": {
      "description": "MCP server status + Hugging Face auth probe (canonical API manager).",
      "steps": [
        "api_manager_doctor",
        "codex_mcp_list",
        "hf_probe_api_manager",
        "mcp_validation_runner_local"
      ]
    },
    "hf-discovery": {
      "description": "Hugging Face discovery artifacts (models/datasets/spaces) via Hub API (not MCP).",
      "steps": [
        "api_manager_doctor",
        "hf_discovery_spaces_session_ops"
      ]
    },
    "mcp-client-emitter": {
      "description": "HF MCPClient tool inventory emitter (real MCP HTTP, artifact-validated).",
      "steps": [
        "api_manager_doctor",
        "hf_mcp_client_emitter"
      ]
    },
    "hf-prep": {
      "description": "Prep-step: verify (and optionally install) HF-related deps for uv+Python 3.13. Emits readiness artifacts.",
      "steps": [
        "api_manager_doctor",
        "hf_prep_verify",
        "hf_prep_apply"
      ]
    },
    "local-ai-readiness": {
      "description": "Pivot gate for local LLM workflows: checks runtime/modules/models and latest overnight artifact health.",
      "steps": [
        "local_ai_readiness_codex",
        "local_ai_readiness_claude",
        "local_ai_readiness_both"
      ]
    },
    "poe-smoke": {
      "description": "Poe API smoke check via OpenAI-compatible models endpoint.",
      "steps": [
        "poe_smoke_active_key",
        "poe_transport_audit"
      ]
    },
    "resume": {
      "description": "Session structuring + resume packet generation (requires an input path).",
      "steps": [
        "structure_session_log",
        "session_resumer"
      ],
      "params": {
        "input_path_required": true
      }
    },
    "all": {
      "description": "Maintenance + MCP/auth + local-ai-readiness + poe-smoke. (Resume lane is intentionally excluded because it requires an explicit input path.)",
      "steps": [
        "maintenance",
        "mcp-auth",
        "local-ai-readiness",
        "poe-smoke"
      ]
    }
  },
  "definitions": {
    "skill_freshness_gate_codex": {
      "cwd": ".",
      "timeout_s": 180,
      "command": [
        "uv",
        "run",
        ".codex/skills/trainstop-orchestrator/scripts/skill_freshness_gate.py",
        "--skills-root",
        ".codex/skills",
        "--emit-json",
        "codex/mailbox/SKILL_FRESHNESS_LATEST.json",
        "--emit-md",
        "codex/mailbox/SKILL_FRESHNESS_LATEST.md",
        "--strict"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "codex/mailbox/SKILL_FRESHNESS_LATEST.json",
        "codex/mailbox/SKILL_FRESHNESS_LATEST.md"
      ]
    },
    "api_manager_doctor": {
      "cwd": ".",
      "timeout_s": 60,
      "command": [
        "pwsh",
        "-NoProfile",
        "-File",
        ".codex/skills/api-manager/scripts/api_manager.ps1",
        "-Doctor"
      ],
      "targets": [
        "codex",
        "claude",
        "both"
      ],
      "artifacts": []
    },
    "toolchain_doctor": {
      "cwd": ".",
      "timeout_s": 600,
      "command": [
        "uv",
        "run",
        ".codex/skills/toolchain-doctor/scripts/toolchain_doctor.py",
        "--bun",
        "--uv"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "codex/mailbox/TOOLCHAIN_DOCTOR_LATEST.md",
        "codex/mailbox/TOOLCHAIN_DOCTOR_REPORT_*.md"
      ]
    },
    "skill_polisher_codex": {
      "cwd": ".",
      "timeout_s": 600,
      "command": [
        "uv",
        "run",
        ".codex/skills/skill-polisher/scripts/polish_skill.py",
        ".codex/skills",
        "--all",
        "--mode",
        "verify",
        "--subprocess-fix",
        "--target-flavor",
        "codex",
        "--emit-stamps-json",
        "codex/mailbox/tatragrammatron_stamps_latest_codex.json",
        "--emit-summary-md",
        "codex/mailbox/TATRAGRAMMATRON_SUMMARY_LATEST_CODEX.md"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "codex/mailbox/tatragrammatron_stamps_latest_codex.json",
        "codex/mailbox/TATRAGRAMMATRON_SUMMARY_LATEST_CODEX.md"
      ]
    },
    "skill_polisher_claude": {
      "cwd": ".",
      "timeout_s": 600,
      "command": [
        "uv",
        "run",
        ".codex/skills/skill-polisher/scripts/polish_skill.py",
        ".claude/skills",
        "--all",
        "--mode",
        "verify",
        "--subprocess-fix",
        "--target-flavor",
        "claude",
        "--no-require-assets"
      ],
      "targets": [
        "claude",
        "both"
      ],
      "artifacts": []
    },
    "mailbox_polisher_codex": {
      "cwd": ".",
      "timeout_s": 300,
      "command": [
        "uv",
        "run",
        "scripts/mailbox_polisher.py",
        "--target",
        "codex",
        "--apply"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "codex/mailbox/mailbox_manifest.json",
        "codex/mailbox/MAILBOX_CURRENT_STATE.md"
      ]
    },
    "mailbox_polisher_claude": {
      "cwd": ".",
      "timeout_s": 300,
      "command": [
        "uv",
        "run",
        "scripts/mailbox_polisher.py",
        "--target",
        "claude",
        "--apply"
      ],
      "targets": [
        "claude",
        "both"
      ],
      "artifacts": [
        "claude/mailbox/mailbox_manifest.json",
        "claude/mailbox/MAILBOX_CURRENT_STATE.md"
      ]
    },
    "mailbox_scribe_codex": {
      "cwd": ".",
      "timeout_s": 300,
      "command": [
        "uv",
        "run",
        "scripts/mailbox_scribe.py",
        "--target",
        "codex",
        "--packet",
        "codex/mailbox/TETRAGRAMMATON_PACKET.md"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "codex/mailbox/TETRAGRAMMATON_PACKET.md"
      ]
    },
    "mailbox_scribe_claude": {
      "cwd": ".",
      "timeout_s": 300,
      "command": [
        "uv",
        "run",
        "scripts/mailbox_scribe.py",
        "--target",
        "claude",
        "--packet",
        "claude/mailbox/TETRAGRAMMATON_PACKET.md"
      ],
      "targets": [
        "claude",
        "both"
      ],
      "artifacts": [
        "claude/mailbox/TETRAGRAMMATON_PACKET.md"
      ]
    },
    "mailbox_manifest_check": {
      "cwd": ".",
      "timeout_s": 60,
      "command": [
        "uv",
        "run",
        "scripts/check_mailbox_manifest.py"
      ],
      "artifacts": []
    },
    "codex_mcp_list": {
      "cwd": ".",
      "timeout_s": 60,
      "command": [
        "codex",
        "mcp",
        "list"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": []
    },
    "hf_probe_api_manager": {
      "cwd": ".",
      "timeout_s": 120,
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        ".\\.codex\\skills\\api-manager\\scripts\\api_manager.ps1 -Load | Out-Null; uv run scripts/hf_probe.py"
      ],
      "required_local_files": [
        "C:\\\\Users\\\\erdno\\\\.chthonic\\\\api_pool.json"
      ],
      "targets": [
        "codex",
        "claude",
        "both"
      ],
      "artifacts": []
    },
    "mcp_validation_runner_local": {
      "cwd": ".",
      "timeout_s": 30,
      "command": [
        "bun",
        "run",
        "scripts/run_mcp_validation.ts"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "artifacts/mcp_run_validation_*.json"
      ]
    },
    "hf_discovery_spaces_session_ops": {
      "cwd": ".",
      "timeout_s": 120,
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        ".\\.codex\\skills\\api-manager\\scripts\\api_manager.ps1 -Load | Out-Null; uv run scripts/hf_discovery.py --kind spaces --q 'mcp tools gradio text extraction ocr' --limit 10"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "artifacts/hf_discovery_spaces_*.json",
        "artifacts/hf_discovery_spaces_*.md"
      ]
    },
    "hf_mcp_client_emitter": {
      "cwd": ".",
      "timeout_s": 120,
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        ".\\.codex\\skills\\api-manager\\scripts\\api_manager.ps1 -Load | Out-Null; uv run scripts/mcp_client_emitter.py --url https://huggingface.co/mcp --min-despair 0"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "artifacts/hf_mcp_tools_*.json",
        "codex/mailbox/HF_MCP_TOOLS_LATEST.json"
      ]
    },
    "hf_prep_verify": {
      "cwd": ".",
      "timeout_s": 240,
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        ".\\.codex\\skills\\api-manager\\scripts\\api_manager.ps1 -Load | Out-Null; uv run scripts/hf_prep.py --with transformers,datasets,accelerate"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "artifacts": [
        "codex/mailbox/HF_PREP_LATEST.json",
        "codex/mailbox/HF_PREP_LATEST.md"
      ]
    },
    "hf_prep_apply": {
      "cwd": ".",
      "timeout_s": 1800,
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        ".\\.codex\\skills\\api-manager\\scripts\\api_manager.ps1 -Load | Out-Null; uv run scripts/hf_prep.py --apply --with transformers,datasets,accelerate --strict"
      ],
      "targets": [
        "codex",
        "both"
      ],
      "requires_apply": true,
      "artifacts": [
        "codex/mailbox/HF_PREP_LATEST.json",
        "codex/mailbox/HF_PREP_LATEST.md"
      ]
    },
    "local_ai_readiness_codex": {
      "cwd": ".",
      "timeout_s": 120,
      "command": [
        "uv",
        "run",
        ".codex/skills/trainstop-orchestrator/scripts/local_ai_readiness.py",
        "--mailboxes",
        "codex"
      ],
      "targets": [
        "codex"
      ],
      "artifacts": [
        "codex/mailbox/LOCAL_AI_READINESS_LATEST.json",
        "codex/mailbox/LOCAL_AI_READINESS_LATEST.md"
      ]
    },
    "local_ai_readiness_claude": {
      "cwd": ".",
      "timeout_s": 120,

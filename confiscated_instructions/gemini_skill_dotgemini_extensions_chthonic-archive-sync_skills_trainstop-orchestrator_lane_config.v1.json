        "claude/mailbox/POE_TRANSPORT_AUDIT_LATEST.md"
      ]
    },
    "structure_session_log": {
      "cwd": ".",
      "command_template": [
        "uv",
        "run",
        "scripts/structure_session_log.py",
        "{input_path}"
      ],
      "artifacts_template": [
        "{input_path}_structured.txt",
        "{input_path}_structured.json",
        "{input_path}_pretty.md"
      ]
    },
    "session_resumer": {
      "cwd": ".",
      "command_template": [
        "uv",
        "run",
        ".codex/skills/session-resumer/scripts/session_resumer.py",
        "{input_path}"
      ],
      "artifacts_template": [
        "{input_path}_resume.md"
      ]
    }
  }
}

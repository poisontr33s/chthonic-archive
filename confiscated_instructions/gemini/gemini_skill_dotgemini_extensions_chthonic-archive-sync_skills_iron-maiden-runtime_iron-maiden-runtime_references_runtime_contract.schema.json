{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chthonic-archive:iron-maiden-runtime-contract:v1",
  "title": "Iron Maiden Runtime Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_cache_keys",
    "inventory_keys",
    "randomization_constraints",
    "voice_output_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "memory_cache_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npcs_met",
        "significant_events",
        "active_plot_threads",
        "keystone_echoes_triggered"
      ],
      "properties": {
        "npcs_met": {
          "type": "string",
          "const": "npcs"
        },
        "significant_events": {
          "type": "string",
          "const": "events"
        },
        "active_plot_threads": {
          "type": "string",
          "const": "plot_threads"
        },
        "keystone_echoes_triggered": {
          "type": "string",
          "const": "echoes_triggered"
        }
      }
    },
    "inventory_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_flow",
        "substances",
        "key_items"
      ],
      "properties": {
        "cash_flow": {
          "type": "string",
          "const": "cash_flow"
        },
        "substances": {
          "type": "string",
          "const": "substances"
        },
        "key_items": {
          "type": "string",
          "const": "items"
        }
      }
    },
    "randomization_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "sparseness",
        "allowed_detail_types"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "description": "Constraint set for minor detail generation.",
          "enum": [
            "rust_belt_psycho_noir"
          ]
        },
        "sparseness": {
          "type": "string",
          "description": "How often minor details should be injected.",
          "enum": [
            "sparse",
            "moderate"
          ]
        },
        "allowed_detail_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "environmental_detail",
              "minor_npc_quirk",
              "smell",
              "sound",
              "texture"
            ]
          },
          "minItems": 1
        }
      }
    },
    "voice_output_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thought_format",
        "conflict_logic",
        "action_attribution"
      ],
      "properties": {
        "thought_format": {
          "type": "string",
          "description": "How voice thoughts are rendered.",
          "enum": [
            "italic_quotes"
          ]
        },
        "conflict_logic": {
          "type": "string",
          "description": "How competing voices are presented.",
          "enum": [
            "explicit_conflict_then_resolution"
          ]
        },
        "action_attribution": {
          "type": "string",
          "description": "Whether to attribute actions to dominant voices.",
          "enum": [
            "explicit_when_relevant"
          ]
        }
      }
    }
  }
}


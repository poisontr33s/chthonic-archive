{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chthonic-archive:iron-maiden-state:v1",
  "title": "Iron Maiden Deterministic State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world",
    "npcs",
    "events",
    "plot_threads",
    "echoes_triggered",
    "cash_flow",
    "substances",
    "items",
    "injuries",
    "voice_weights"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "location_hint"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "rust_belt_psycho_noir"
          ]
        },
        "location_hint": {
          "type": "string",
          "description": "Short anchor for where the scene starts (e.g., a bar, backstage, a riverfront)."
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "relationship_status"
        ],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "relationship_status": {
            "type": "string",
            "enum": [
              "hostile",
              "uneasy_ally",
              "indebted",
              "neutral",
              "wary_trust",
              "complex",
              "deceased"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "victory",
              "loss",
              "betrayal",
              "choice",
              "injury"
            ]
          },
          "summary": { "type": "string" }
        }
      }
    },
    "plot_threads": {
      "type": "array",
      "items": { "type": "string" }
    },
    "echoes_triggered": {
      "type": "array",
      "description": "Recent keystone echoes, newest last.",
      "items": {
        "type": "string",
        "enum": [
          "coach",
          "rival_vyper",
          "lost_love",
          "family_wound",
          "match_failure",
          "pyro_incident",
          "tokyo_scar"
        ]
      }
    },
    "cash_flow": {
      "type": "string",
      "enum": [
        "broke",
        "scraping_by",
        "fleeting_payday",
        "owes_big"
      ]
    },
    "substances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity"
        ],
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 },
          "unit": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "injuries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "severity"
        ],
        "properties": {
          "name": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "severe"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "voice_weights": {
      "type": "object",
      "description": "Deterministic weights per voice id (1..23). Higher means more likely to fire.",
      "additionalProperties": false,
      "patternProperties": {
        "^(?:[1-9]|1\\d|2[0-3])$": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}


{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cargo build",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$rustc",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "cargo build --release",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--release"
			],
			"group": "build",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "cargo run",
			"type": "shell",
			"command": "cargo",
			"args": [
				"run"
			],
			"group": "build",
			"problemMatcher": [
				"$rustc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "cargo clippy",
			"type": "shell",
			"command": "cargo",
			"args": [
				"clippy",
				"--all-targets",
				"--all-features",
				"--",
				"-W",
				"clippy::pedantic"
			],
			"group": "test",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "cargo test",
			"type": "shell",
			"command": "cargo",
			"args": [
				"test"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "cargo clean",
			"type": "shell",
			"command": "cargo",
			"args": [
				"clean"
			],
			"problemMatcher": []
		},
		{
			"label": "🔺 Run Archive (Debug)",
			"type": "shell",
			"command": "cargo",
			"args": [
				"run"
			],
			"group": "none",
			"problemMatcher": [
				"$rustc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "🚀 Run Archive (Release)",
			"type": "shell",
			"command": "cargo",
			"args": [
				"run",
				"--release"
			],
			"group": "none",
			"problemMatcher": [
				"$rustc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "🔥 Inject ASC Framework into Copilot",
			"type": "shell",
			"command": "Write-Host",
			"args": [
				"-ForegroundColor",
				"Cyan",
				"'🔥💀⚓ ASC Framework Context Available via MCP Server: asc-injector\\n\\nUse @asc-injector in Copilot Chat or invoke resource: asc://ssot\\n\\nRestart VS Code if MCP server not visible.'"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"focus": true
			},
			"problemMatcher": [
				"$nvcc"
			]
		},
		{
			"label": "Run Inline Page Test",
			"type": "shell",
			"command": "cd bun-playwright-poc && bun run inline-page-test.ts"
		},
		{
			"label": "List Playwright Browsers",
			"type": "shell",
			"command": "Get-ChildItem -Path \"$env:LOCALAPPDATA\\ms-playwright\" -Directory | Select-Object Name"
		},
		{
			"label": "List Chromium Contents",
			"type": "shell",
			"command": "Get-ChildItem -Path \"$env:LOCALAPPDATA\\ms-playwright\\chromium-1207\" | Select-Object Name"
		},
		{
			"label": "Inline Page Test",
			"type": "shell",
			"command": "cd bun-playwright-poc && bun run inline-page-test.ts"
		},
		{
			"label": "Run Inline Page Test 2",
			"type": "shell",
			"command": "cd bun-playwright-poc && bun run inline-page-test.ts"
		},
		{
			"label": "Test Fixed Navigation",
			"type": "shell",
			"command": "cd bun-playwright-poc && bun run example-buncdp.ts"
		},
		{
			"label": "Test Interaction",
			"type": "shell",
			"command": "cd bun-playwright-poc && bun run test-interaction.ts"
		},
		{
			"label": "Test NetworkIdle",
			"type": "shell",
			"command": "cd bun-playwright-poc && bun run test-networkidle.ts"
		},
		{
			"label": "Fix and Test",
			"type": "shell",
			"command": "bun install; bun test; ridk version > ridk_info.txt; Get-Command ridk | Out-File ridk_path.txt",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Bun Verify",
			"type": "shell",
			"command": "bun install; bun test",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Final Verify",
			"type": "shell",
			"command": "cargo build; bun install; ridk exec pacman -Syu --noconfirm",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Bun Add Vega",
			"type": "shell",
			"command": "bun add vega-design-system@latest",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Fix VS Code CLI & Claude Integrator",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/fix_vscode_cli.ps1"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Chthonic: Post-Restart Verify (Insiders)",
			"type": "shell",
			"command": "bun run --cwd extensions/chthonic-archive insiders:post-restart:verify",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			},
			"problemMatcher": []
		},
		{
			"label": "Chthonic: Restart Gate Check (Insiders)",
			"type": "shell",
			"command": "bun run --cwd extensions/chthonic-archive insiders:restart:gate",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			},
			"problemMatcher": []
		}
	]
}

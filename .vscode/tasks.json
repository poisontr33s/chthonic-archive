{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "⚡ Dispatch Push (origin/main)",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}/scripts/dispatch-push.ps1"
			],
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Dispatch-triggered push to origin/main. Reads commit msg from .chthonic/dispatch-commit-msg.tmp if present, otherwise uses timestamp. Run via Terminal → Run Task."
		},
		{
			"label": "cargo build",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": {
				"owner": "rustc",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(error|warning)\\[.*\\]:\\s+(.*)$|^\\s+-->\\s+(.+):(\\d+):(\\d+)",
					"file": 3,
					"line": 4,
					"column": 5,
					"message": 2,
					"severity": 1
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "cargo build --release",
			"type": "shell",
			"command": "cargo",

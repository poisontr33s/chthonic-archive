{
  // 🔥💀⚓ Chthonic Archive - MCP Server Configuration
  // Bun-native: install once, execute directly, no runtime surprises

  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },

    "playwright": {
      "type": "stdio",
      "command": "node_modules/.bin/mcp-server-playwright",
      "args": [
        "--browser",
        "chromium"
      ],
      "cwd": "C:\\Users\\erdno\\chthonic-archive"
    },

    "bun-docs": {
      "type": "http",
      "url": "https://bun.com/docs/mcp"
    },

    "microsoft-docs": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },

    "filesystem": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\erdno\\chthonic-archive"
      ],
      "cwd": "C:\\Users\\erdno\\chthonic-archive"
    },

    "artisan": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "scripts/mcp_artisan_server.ts"
      ],
      "cwd": "C:\\Users\\erdno\\chthonic-archive"
    },

    "asc-injector": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "scripts/mcp-asc-injector.ts"
      ],
      "cwd": "C:\\Users\\erdno\\chthonic-archive",
      "env": {
        "SSOT_PATH": ".github/copilot-instructions.md"
      }
    }
  }
}


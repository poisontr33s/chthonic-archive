{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "all",
        "X-MCP-Insiders": "true"
      }
    },
    "browser": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "scripts/mcp-browser.ts"
      ],
      "cwd": "${workspaceFolder}"
    },
    "bun-docs": {
      "type": "http",
      "url": "https://bun.com/docs/mcp"
    },
    "microsoft-docs": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "chthonic-v3": {
      "type": "stdio",
      "command": "${workspaceFolder}/target/release/chthonic-mcp-server.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "CHTHONIC_ROOT": "${workspaceFolder}"
      }
    },
    "workiq": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "--bun",
        "-y",
        "@microsoft/workiq@latest",
        "mcp"
      ]
    },
    "mas-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--directory",
        "${workspaceFolder}/mas_mcp",
        "python",
        "-m",
        "server"
      ],
      "cwd": "${workspaceFolder}"
    },
    "filesystem": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "scripts/mcp-filesystem.ts",
        "${workspaceFolder}",
        "${env:USERPROFILE}\\PsychoNoir-Kontrapunkt",
        "${env:USERPROFILE}\\Restructure-MCP-Orchestration",
        "${env:USERPROFILE}\\Claudine_Supreme-Polyglot-Git-Cli-Lsp-Repo-Clone-Engineering-Bun-Technique",
        "${env:USERPROFILE}\\git-dump-lfs-holder-we-it-takes",
        "${env:USERPROFILE}\\psychonoir-kontrapunkt-large-file-holder"
      ],
      "cwd": "${workspaceFolder}"
    },
    "io.github.upstash/context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github-archaeology": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "scripts/mcp-github-archaeology.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ARCHAEOLOGY_REPO": "poisontr33s/Restructure-MCP-Orchestration"
      }
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer ${env:HUGGINGFACE_API_KEY}"
      }
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "--bun",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "--bun",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "time": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "${workspaceFolder}"
      ]
    }
  }
}

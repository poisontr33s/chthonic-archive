    // === EDITOR CORE ===
    "editor.formatOnSave": false,
    "editor.rulers": [100, 120],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.maxTokenizationLineLength": 99999999999,
    "editor.experimental.asyncTokenization": false,
    "editor.inlineSuggest.showToolbar": "always",
    "editor.tokenColorCustomizations": {
        "[Default Dark+]": {
            "textMateRules": []
        }
    },
    "diffEditor.maxComputationTime": 0,
    "workbench.colorTheme": "Chthonic — Geological Core (Sister Ferrum Scoriae)",
    "workbench.iconTheme": "chthonic-file-icons",
    "workbench.productIconTheme": "chthonic-product-icons",
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.experimental.cloudChanges.partialMatches.enabled": true,
    "task.notifyWindowOnTaskCompletion": -1,

    // === CHTHONIC THERMAL CONTAINMENT ===
    // Disable all high-I/O/background runtime lanes.
    "chthonic.entropy.enabled": false,
    "chthonic.entropy.polyglotEnabled": false,
    "chthonic.slab.selfHealingEnabled": false,
    "chthonic.reactor.enabled": false,
    "chthonic.showLineage": false,

    // === GIT / SCM THERMAL CONTAINMENT ===
    // 1.37 GiB repo, 2463 tracked files — default polling is a laptop-killer.
    "git.autorefresh": false,
    "git.autofetch": false,
    "git.decorations.enabled": false,
    "git.statusLimit": 500,
    "scm.diffDecorations": "none",

    // === FILE ASSOCIATIONS ===
    "files.associations": {
        "*.vert": "glsl",
        "*.frag": "glsl",
        "*.geom": "glsl",
        "*.comp": "glsl",
        "*.tesc": "glsl",
        "*.tese": "glsl",
        "*.md": "markdown",
        "*.json": "jsonc"
    },

    // === FILE EXCLUSIONS (Performance + Thermal) ===
    "files.exclude": {
        "**/target": true,
        "**/*.spv": false,
        "**/Cargo.lock": false
    },
    "files.watcherExclude": {
        "**/target/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/dumpster-dive/**": true,
        "**/build/**": true,
        "**/artifacts/**": true,
        "**/__pycache__/**": true,
        "**/book/**": true
    },
    "search.exclude": {
        "**/target": true,
        "**/node_modules": true,
        "**/dumpster-dive": true,
        "**/build": true,
        "**/artifacts": true,
        "**/__pycache__": true,
        "**/.git": true,
        "**/book": true
    },

    // === TERMINAL ===
    // THERMAL CONTAINMENT: Minimize integrated terminal overhead.
    // Agent commands run here but decorations/suggestions/scroll are thermal load per keystroke.
    // Force UTF-8 in VS Code terminal (matches system-wide registry setting)
    // Unsupported in the current Insiders build; preserved for future revalidation.
    // "terminal.integrated.defaultEncoding": "utf8",
    // Unicode 11 width tables — correct emoji/CJK column widths
    "terminal.integrated.unicodeVersion": "11",
    // Stability gate: disable terminal GPU acceleration while Insiders renderer crashes are being triaged.
    "terminal.integrated.gpuAcceleration": "off",
    // Triage gate: capture terminal diagnostics in trace mode.
    // Unsupported in the current Insiders build; preserved for future revalidation.
    // "terminal.integrated.logLevel": "trace",
    // Kill the yellow "wants to contribute" env warning banner
    // Unsupported in the current Insiders build; preserved for future revalidation.
    // "terminal.integrated.environmentChangesIndicator": "off",
    // Auto-apply extension env changes without the "relaunch" nag
    "terminal.integrated.environmentChangesRelaunch": false,
    // Polyglot mode: profile loads chthonic env automatically
    "terminal.integrated.profiles.windows": {
        "Pwsh (Chthonic)": {
            "path": "C:\\Users\\eldno\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
            "args": ["-NoLogo"],
            "icon": "terminal-powershell"
        },
        "Pwsh (No Profile)": {
            "path": "C:\\Users\\eldno\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
            "args": ["-NoProfile", "-NoLogo"],
            "icon": "terminal"
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // Enable shell integration — allows extensions to run commands and capture output without a full debug adapter
    "terminal.integrated.shellIntegration.enabled": true,
    // THERMAL: Disable decoration rendering — saves per-line DOM ops
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.shellIntegration.showCommandGuide": false,
    "terminal.integrated.shellIntegration.history": 100,
    // THERMAL: Disable suggest widget — removes keystroke-level event handlers
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.suggestOnTriggerCharacters": false,
    // THERMAL: Disable sticky scroll — removes scroll-event DOM updates
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.commandsToSkipShell": ["bash", "wsl", "ubuntu"],
    "terminal.integrated.env.windows": {
    "PATH": "${env:PATH}",
        "RUST_BACKTRACE": "1",
        "RUST_LOG": "info,chthonic_archive=debug"
    },

    // Rust Analyzer is not currently installed in this profile; preserving these settings for restore.
    // "rust-analyzer.cargo.allFeatures": true,

    // === CLAUDE CODE ===
    "claudeCode.selectedModel": "claude-opus-4-6",
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.useTerminal": true,
    "claudeCode.respectGitIgnore": false,
    "claudeCode.initialPermissionMode": "default",
    "claudeCode.preferredLocation": "panel",

    // === MISC ===
    "@azure.enableAutoSetAzureRules": false,
    "chatgpt.commentCodeLensEnabled": true,
    "chatgpt.openOnStartup": true,
    "chatgpt.composerEnterBehavior": "cmdIfMultiline",
    "chatgpt.thinkingMode": "low"

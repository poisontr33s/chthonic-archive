{
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║   THE CHTHONIC ARCHIVE - Debug Configuration                     ║
    // ║   RTX 4090 Vulkan Engine | Native Windows Debugging              ║
    // ║   Win 11 natural launchers: VS 2026 Insiders, Build Tools, SSMS ║
    // ╚══════════════════════════════════════════════════════════════════╝
    "version": "0.2.0",
    "configurations": [
    
        {
            // Quick run with full Rust backtraces - no external debugger needed
            "name": "▶️ Run Debug (Console)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo run",
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "full",
                "RUST_LOG": "info,chthonic_archive=debug",
                "VK_LOADER_DEBUG": "warn"
            }
        },
        {
            // Launch the installed Visual Studio 2026 Insiders debugger.
            "name": "🔥 Debug in Visual Studio 2026 Insiders",
            "type": "node-terminal",
            "request": "launch",
            "command": "$vsInsiders = Join-Path $env:ProgramFiles 'Microsoft Visual Studio\\18\\Insiders\\Common7\\IDE\\devenv.exe'; Start-Process -FilePath $vsInsiders -ArgumentList '/debugexe', 'target\\debug\\chthonic-archive.exe'",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build"
        },
        {
            // Open the installed Visual Studio 2026 Build Tools developer command prompt.
            "name": "🧰 Open VS 2026 Build Tools Dev Cmd",
            "type": "node-terminal",
            "request": "launch",
            "command": "$vsBuildTools = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\\18\\BuildTools\\Common7\\Tools\\LaunchDevCmd.bat'; Start-Process -FilePath $vsBuildTools",
            "cwd": "${workspaceFolder}"
        },
        {
            // Open the installed SQL Server Management Studio 22 release IDE.
            "name": "🗄️ Open SSMS 22 Release",
            "type": "node-terminal",
            "request": "launch",
            "command": "$ssms = Join-Path $env:ProgramFiles 'Microsoft SQL Server Management Studio 22\\Release\\Common7\\IDE\\SSMS.exe'; Start-Process -FilePath $ssms",
            "cwd": "${workspaceFolder}"
        },
        {
            // Release mode - optimized, minimal debug info
            "name": "🚀 Run Release (Console)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo run --release",
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1",
                "RUST_LOG": "info"
            }
        },
        {
            // Build only - useful for checking compilation
            "name": "🔨 Build Debug",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo build",
            "cwd": "${workspaceFolder}"
        }
    ]
}

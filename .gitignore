# Ignore everything
*

# Allow git metadata
!.gitignore
!.copilotignore
!.gitattributes

# Allow PR/patch suggestions
!PR_SUGGESTION.md

# Allow DCRP Cross-Reference System (Section XV)
!decorator_cross_ref_maximum.py
!dependency_graph.json
!CROSS_REFERENCE_TRIPTYCH.md

# Allow MCP autonomous prerequisites (immutable)
!docs/
!docs/**
!docs/MCP_*.md
!docs/CLI_EDITING_POLICY.md
!docs/CLAUDE_CODE_REGISTRATION.md

# Allow migrated session/framework/handoff docs (Stage 1 repurposing)
!docs/sessions/
!docs/sessions/**
!docs/frameworks/
!docs/frameworks/**
!docs/handoffs/
!docs/handoffs/**
!docs/DCRP_SYNTHESIS.md
!docs/STAGE_1_MIGRATION_PLAN.md
!docs/SSOTIFICATION_METHODOLOGY.md
!docs/protocols/
!docs/protocols/**

# Allow SSOT Hub and Indices
!.ankhrc
!ankh_index.json
!sid_index.json

# Allow dumpster-dive consolidated archives
!dumpster-dive/
!dumpster-dive/**
# Exclude transient overnight daemon outputs (regenerable nightly)
dumpster-dive/intake/overnight-daemon/*/classifications/
dumpster-dive/intake/overnight-daemon/*/report.json
dumpster-dive/intake/overnight-daemon/*/report.md
dumpster-dive/intake/overnight-daemon/*/run.json
dumpster-dive/intake/overnight-daemon/*/.keep
dumpster-dive/intake/overnight-daemon/*.log

# Exclude corpse-vault (generated by corpse-reviver, regenerable)
dumpster-dive/corpse-vault/
# Exclude furnace C# build outputs (generated by dotnet build)
dumpster-dive/forge/furnace/csharp/bin/
dumpster-dive/forge/furnace/csharp/obj/


# Allow MCP server implementation
!mcp/
!mcp/*.ts
!mcp/*.md
!mcp/*.json
!mcp/*.ps1
!mcp/tools/
!mcp/tools/*.ts
!mcp/tools/*.json

# Allow MAS MCP server (FastMCP — mas_mcp/)
!mas_mcp/
!mas_mcp/*.py
!mas_mcp/*.toml
!mas_mcp/*.md
!mas_mcp/*.txt
!mas_mcp/logic/

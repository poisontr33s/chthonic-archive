!mas_mcp/tests/
!mas_mcp/tests/test_ssot_binding.py
!mas_mcp/abbreviation_system/
!mas_mcp/abbreviation_system/*.py
# Exclude mas_mcp transient artifacts
mas_mcp/.venv/
mas_mcp/__pycache__/
mas_mcp/**/__pycache__/
mas_mcp/uv.lock
.mas_mcp/

# Allow Bun configuration
!bunfig.toml

# Allow Python project manifest (Unified Metabolic Field — PMS-v3)
!pyproject.toml

# Allow Chthonic Golden fork prototype
!chthonic-golden/
!chthonic-golden/**


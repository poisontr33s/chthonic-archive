# .chthonic/ — the catalyst lane (2026-05-27). SSOT.md is non-expendable canon
# per [reference-ssot-triple-abstraction-decryption-key]; the grammar file is
# the Phase 0 DSL substrate. Track these explicitly so a `git clean -fdx` or
# similar cannot erase the substrate. Narrow allowlist: catalyst + grammar +
# seed file only; the cache/ledger/packets/trail/stones subdirs stay ignored
# as runtime/workspace state, not canon.
!.chthonic/
!.chthonic/SSOT.md
!.chthonic/grammar/
!.chthonic/grammar/*.peg
!.chthonic/grammar/*.json
!.chthonic/ankh_seeds.yaml
!.chthonic/REM_BLUEPRINT.md

# tools/dsl-smoke/ — Phase 0 grammar iteration tools (2026-05-27).
# Cargo workspace member. build.rs copies .chthonic/grammar/chthonic.peg
# into src/chthonic.pest at compile time (the .pest file stays ignored —
# it's a build artifact). target/ and Cargo.lock also ignored.
# Parent-dir admittance needed before child rules can apply.
!tools/
!tools/dsl-smoke/
!tools/dsl-smoke/Cargo.toml
!tools/dsl-smoke/build.rs
!tools/dsl-smoke/README.md
!tools/dsl-smoke/src/
!tools/dsl-smoke/src/*.rs

# tools/dsl-iteration-toolkit/ — generalized methodology layer (2026-05-27).
# Cargo workspace member. Library + dsl-iter CLI. Uses pest_vm for runtime
# grammar loading (no compile-time grammar binding).
!tools/dsl-iteration-toolkit/
!tools/dsl-iteration-toolkit/Cargo.toml
!tools/dsl-iteration-toolkit/*.md
!tools/dsl-iteration-toolkit/src/
!tools/dsl-iteration-toolkit/src/*.rs
!tools/dsl-iteration-toolkit/src/bin/
!tools/dsl-iteration-toolkit/src/bin/*.rs

# Per-project dsl-iter.toml config files (the chthonic instance).
!.chthonic/dsl-iter.toml


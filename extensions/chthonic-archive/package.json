{
  "name": "chthonic-archive",
  "displayName": "Chthonic Archive",
  "description": "VS Code workspace extension for the Chthonic Archive — themes, status bar, sidebar, and policy tools.",
  "version": "0.2.6",
  "publisher": "chthonic-archive",
  "icon": "icons/mandala.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chthonic-archive/chthonic-archive"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Themes",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Chthonic — Flesh & Earth (The Decorator)",
        "uiTheme": "vs-dark",
        "path": "./themes/chthonic-mandala-color-theme.json"
      },
      {
        "label": "Chthonic — ROGBIV (Spectra Chroma)",
        "uiTheme": "vs-dark",
        "path": "./themes/chthonic-rogbiv-color-theme.json"
      },
      {
        "label": "Chthonic — Geological Core (Sister Ferrum Scoriae)",
        "uiTheme": "vs-dark",
        "path": "./themes/chthonic-geology-color-theme.json"
      },
      {
        "label": "Chthonic — The Decorator",
        "uiTheme": "vs-dark",
        "path": "./themes/chthonic-decorator-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "chthonic-file-icons",
        "label": "Chthonic Archive File Icons",
        "path": "./themes/chthonic-file-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "chthonic-product-icons",
        "label": "Chthonic Archive Product Icons",
        "path": "./themes/chthonic-product-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "glsl",
        "aliases": ["GLSL", "OpenGL Shading Language"],
        "extensions": [".glsl", ".vert", ".frag", ".geom", ".comp", ".tesc", ".tese"],
        "configuration": "./language-configuration-glsl.json"
      },
      {
        "id": "toml",
        "aliases": ["TOML", "toml"],
        "extensions": [".toml"],
        "configuration": "./language-configuration-toml.json"
      }
    ],
    "grammars": [
      {
        "language": "glsl",
        "scopeName": "source.glsl",
        "path": "./syntaxes/glsl.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "chthonic.switchTheme",
        "title": "Chthonic: Switch Theme",
        "icon": "$(paintcan)"
      },
      {
        "command": "chthonic.refreshStatus",
        "title": "Chthonic: Refresh Status Bar"
      },
      {
        "command": "chthonic.verifySSOT",
        "title": "Chthonic: Verify Policy Fingerprint"
      },
      {
        "command": "chthonic.entropyRefresh",
        "title": "Chthonic: Refresh Workspace Health Overlay",
        "icon": "$(pulse)"
      },
      {
        "command": "chthonic.activateCockpit",
        "title": "Chthonic: Activate Cockpit Layout",
        "icon": "$(layout)"
      },
      {
        "command": "chthonic.annoDetect",
        "title": "Chthonic: Detect Project Tooling (ANNO)",
        "icon": "$(tools)"
      },
      {
        "command": "chthonic.reactorSediment",
        "title": "Chthonic: Compute Sediment Layers",
        "icon": "$(layers)"
      },
      {
        "command": "chthonic.openStylusInput",
        "title": "Chthonic: Open Stylus / Handwriting Pad",
        "icon": "$(edit)"
      },
      {
        "command": "chthonic.openClaudeDesignFrame",
        "title": "Chthonic: Open Claude Design Frame",
        "icon": "$(preview)"
      },
      {
        "command": "chthonic.deepFocus",
        "title": "Chthonic: Deep Focus Layout",
        "icon": "$(target)"
      },
      {
        "command": "chthonic.restoreOrder",
        "title": "Chthonic: Restore Order Layout",
        "icon": "$(list-tree)"
      },
      {
        "command": "chthonic.slabHeal",
        "title": "Chthonic: Self-Heal Slab",
        "icon": "$(tools)"
      },
      {
        "command": "chthonic.refreshRustification",
        "title": "Chthonic: Refresh Toolchain Completeness Score",
        "icon": "$(pulse)"
      },
      {
        "command": "chthonic.openWebCockpit",
        "title": "Chthonic: Open Next Cockpit",
        "icon": "$(globe)"
      },
      {
        "command": "chthonic.startWebCockpit",
        "title": "Chthonic: Start Next Cockpit (bun --bun next dev)",
        "icon": "$(play)"
      },
      {
        "command": "chthonic.openBunTrainingDocs",
        "title": "Chthonic: Open Bun Training Docs",
        "icon": "$(book)"
      },
      {
        "command": "chthonic.postRestartVerify",
        "title": "Chthonic: Post-Restart Verify",
        "icon": "$(check)"
      },
      {
        "command": "chthonic.restartGate",
        "title": "Chthonic: Restart Gate Check",
        "icon": "$(debug-pause)"
      },
      {
        "command": "chthonic.runtimeStatus",
        "title": "Chthonic: Runtime Status",
        "icon": "$(pulse)"
      },
      {
        "command": "chthonic.pasteRenderedAiMarkdown",
        "title": "Chthonic: Paste Rendered AI HTML as Markdown",
        "icon": "$(markdown)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "chthonic.pasteRenderedAiMarkdown",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chthonic-archive",
          "title": "Chthonic Archive",
          "icon": "resources/mandala.svg"
        }
      ]
    },
    "views": {
      "chthonic-archive": [
        {
          "id": "chthonic.chatView",
          "type": "webview",
          "name": "☥ ANKH Reference",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "chthonic.abyssalView",
          "type": "webview",
          "name": "Abyssal Pane",
          "icon": "resources/mandala.svg"
        },
        {
          "id": "chthonic.themeView",
          "name": "Themes",
          "icon": "$(paintcan)"
        },
        {
          "id": "chthonic.statusView",
          "name": "Lens",
          "icon": "$(pulse)"
        },
        {
          "id": "chthonic.loomView",
          "type": "webview",
          "name": "The Loom",
          "icon": "resources/loom.svg"
        },
        {
          "id": "chthonic.designFrameView",
          "type": "webview",
          "name": "Design Frame",
          "icon": "$(preview)",
          "visibility": "collapsed"
        },
        {
          "id": "chthonic.stylusView",
          "type": "webview",
          "name": "✍️ Stylus Pad",
          "icon": "$(edit)",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Chthonic Archive",
      "properties": {
        "chthonic.ankh.sourcePath": {
          "type": "string",
          "default": "",
          "description": "Override source file for the ANKH Reference pane (relative to workspace root or absolute). When set and the file exists, takes precedence over epoch auto-discovery and legacy archive."
        },
        "chthonic.ssotPath": {
          "type": "string",
          "default": ".github/copilot-instructions.md",
          "description": "Path to the policy file for fingerprint verification (relative to workspace root)."
        },
        "chthonic.showSSOTHash": {
          "type": "boolean",
          "default": false,
          "description": "Show policy fingerprint in status bar (opt-in)."
        },
        "chthonic.showLineage": {
          "type": "boolean",
          "default": false,
          "description": "Show active lineage indicator in status bar."
        },
        "chthonic.entropy.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable workspace health analysis and explorer health decoration overlay (opt-in)."
        },
        "chthonic.entropy.maxFiles": {
          "type": "number",
          "default": 3000,
          "minimum": 200,
          "description": "Maximum number of files scanned by the workspace health worker."
        },
        "chthonic.entropy.scanIntervalMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "description": "Background workspace health rescan interval in milliseconds."
        },
        "chthonic.entropy.decorationDebounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Debounce interval for FileDecorationProvider updates."
        },
        "chthonic.entropy.decorationBatchSize": {
          "type": "number",
          "default": 240,
          "minimum": 64,
          "description": "Maximum URI updates emitted per FileDecorationProvider flush."
        },
        "chthonic.entropy.polyglotEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable uv/Ruby sidecars, Merkle accumulation, and Solana settlement workflows (opt-in)."
        },
        "chthonic.entropy.pythonScanIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1e4,
          "description": "Interval for uv-managed ruff workspace health scans."
        },
        "chthonic.entropy.ledgerSettleDebounceMs": {
          "type": "number",
          "default": 1400,
          "minimum": 300,
          "description": "Debounce window for Merkle settlement writes triggered by workspace save/commit."
        },
        "chthonic.entropy.ledgerMode": {
          "type": "string",
          "enum": [
            "validator",
            "bankrun"
          ],
          "default": "bankrun",
          "description": "Ledger backend mode. 'bankrun' uses in-memory simulation; 'validator' uses the Rust sidecar host (requires native build)."
        },
        "chthonic.entropy.solanaRpcUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8899",
          "description": "RPC URL for local Solana validator settlement probes."
        },
        "chthonic.entropy.solanaAutostartValidator": {
          "type": "boolean",
          "default": false,
          "description": "Attempt to autostart solana-test-validator in the workspace."
        },
        "chthonic.entropy.solanaLedgerHostBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Rust ledger-host binary."
        },
        "chthonic.entropy.solanaWalletPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to payer keypair JSON for the Rust ledger host."
        },
        "chthonic.entropy.solanaIdlPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Anchor IDL consumed by the Rust ledger host."
        },
        "chthonic.reactor.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Workspace Health Reactor (ANNO + Vulkan compute daemon) (opt-in)."
        },
        "chthonic.reactor.headlessVulkan": {
          "type": "boolean",
          "default": true,
          "description": "Enable headless Vulkan compute for sediment layer calculation. Falls back to CPU if unavailable."
        },
        "chthonic.reactor.daemonBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the chthonic-daemon binary."
        },
        "chthonic.reactor.transport": {
          "type": "string",
          "enum": [
            "auto",
            "shared_memory",
            "jsonl"
          ],
          "default": "auto",
          "description": "Sediment transport mode. 'auto' prefers shared memory synapse and falls back to JSONL."
        },
        "chthonic.reactor.cockpitAutoLayout": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply Cockpit layout (terminal right, editor center) on activation."
        },
        "chthonic.slab.selfHealingEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable periodic slab self-healing via endoflife.date checks and mise upgrade (opt-in)."
        },
        "chthonic.slab.selfHealingIntervalMs": {
          "type": "number",
          "default": 21600000,
          "minimum": 60000,
          "description": "Background slab self-healing interval in milliseconds."
        },
        "chthonic.slab.eolApiBase": {
          "type": "string",
          "default": "https://endoflife.date/api",
          "description": "Base URL for endoflife lifecycle API used by slab self-healing."
        },
        "chthonic.security.allowNativeSidecars": {
          "type": "boolean",
          "default": false,
          "description": "Master kill-switch for native/sidecar process lanes (daemon, ledger host, Solana validator, Python/Ruby sidecars, and slab self-healing probes)."
        },
        "chthonic.dev.autoReload": {
          "type": "boolean",
          "default": false,
          "description": "When true, the extension reloads the VS Code window automatically whenever dist/extension.js changes (via bun build --watch). Opt-in; intended for extension-host iteration."
        },
        "chthonic.webCockpit.url": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "URL for the Bun/Next training cockpit opened from extension commands."
        },
        "chthonic.webCockpit.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Auto-start the Bun/Next cockpit dev server when Chthonic Archive activates."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "bun run scripts/bootstrap-env.ts",
    "setup:oxidized": "bun run scripts/setup-oxidized.ts",
    "verify:host": "bun run scripts/toolpool-scan.ts --quiet && bun run scripts/verify-host.ts",
    "verify:codex": "bun run scripts/verify-host.ts --codex-only",
    "precompile": "bun run verify:host",
    "prepublish:bundle": "bun run compile",
    "build:ledger": "bun run scripts/verify-host.ts && bun run scripts/build-ledger.ts",
    "build:wasm": "bun run scripts/verify-host.ts && bun run scripts/build-wasm.ts",
    "build:daemon": "bun run scripts/verify-host.ts && bun run scripts/build-daemon.ts",
    "build:synapse": "bun run scripts/verify-host.ts && bun run scripts/build-synapse.ts",
    "build:all": "bun run build:ledger && bun run build:wasm && bun run build:daemon && bun run build:synapse && bun run compile",
    "toolpool:scan": "bun run scripts/toolpool-scan.ts",
    "toolpool:scan:json": "bun run scripts/toolpool-scan.ts --json",
    "toolpool:wire": "bun run scripts/toolpool-scan.ts --write-env",
    "audit:vs2026": "pwsh -NoProfile -File scripts/vs2026_audit.ps1 -Json",
    "audit:vs2026:strict": "pwsh -NoProfile -File scripts/vs2026_audit.ps1 -Strict",
    "sql:version": "pwsh -NoProfile -File scripts/sqlpackage_task.ps1 -Mode version",
    "compile": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --minify && bun build src/entropy/entropyWorker.ts --outfile dist/entropy-worker.js --target node --format cjs --minify",
    "test:markdown-paste": "bun run scripts/markdown-paste-fixture.ts",
    "test:markdown-paste:stress": "bun run scripts/markdown-paste-stress-corpus.ts",
    "test:daemon-jsonl": "bun run scripts/daemon-jsonl-smoke.ts",
    "test:webview-hmr": "bun run scripts/webview-hmr-smoke.ts",
    "watch": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --watch",
    "watch:worker": "bun build src/entropy/entropyWorker.ts --outfile dist/entropy-worker.js --target node --format cjs --watch",
    "test:e2e": "bun run scripts/e2e-extension-host.ts",
    "verify:all": "bun run scripts/verify-all.ts",
    "insiders:kits:check": "bunx @vscode/vsce --version && bunx vscode-test-web --help",
    "insiders:package": "bun run compile && bunx @vscode/vsce package --pre-release --no-dependencies --out chthonic-archive-insiders.vsix --skip-license",
    "insiders:run": "code-insiders --extensionDevelopmentPath=.",
    "insiders:dts:sync": "bunx @vscode/dts dev && bunx @vscode/dts main",
    "insiders:restart:gate": "bun run scripts/insiders-post-restart-verify.ts --gate-only",
    "insiders:post-restart:verify": "bun run scripts/insiders-post-restart-verify.ts"
  },
  "devDependencies": {
    "@openai/agents": "^0.8.0",
    "@openai/codex-sdk": "^0.116.0",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@vscode/dts": "^0.4.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.7.1",
    "@types/turndown": "5.0.6",
    "markdown-it": "14.1.1",
    "openai": "^6.32.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}

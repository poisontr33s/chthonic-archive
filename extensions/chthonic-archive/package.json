{
  "name": "chthonic-archive",
  "displayName": "Chthonic Archive",
  "description": "VS Code workspace extension for the Chthonic Archive — themes, status bar, sidebar, and SSOT tools.",
  "version": "0.2.0",
  "publisher": "chthonic-archive",
  "icon": "icons/mandala.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/chthonic-archive/chthonic-archive"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Chthonic Mandala - Flesh & Earth",
        "uiTheme": "vs-dark",
        "path": "./themes/chthonic-mandala-color-theme.json"
      },
      {
        "label": "Chthonic Mandala - ROGBIV",
        "uiTheme": "vs-dark",
        "path": "./themes/chthonic-rogbiv-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "chthonic.switchTheme",
        "title": "Chthonic: Switch Theme",
        "icon": "$(paintcan)"
      },
      {
        "command": "chthonic.refreshStatus",
        "title": "Chthonic: Refresh Status Bar"
      },
      {
        "command": "chthonic.verifySSOT",
        "title": "Chthonic: Verify SSOT Hash"
      },
      {
        "command": "chthonic.entropyRefresh",
        "title": "Chthonic: Refresh Entropy Overlay",
        "icon": "$(pulse)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chthonic-archive",
          "title": "Chthonic Archive",
          "icon": "resources/mandala.svg"
        }
      ]
    },
    "views": {
      "chthonic-archive": [
        {
          "id": "chthonic.chatView",
          "type": "webview",
          "name": "Agent Chat",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "chthonic.abyssalView",
          "type": "webview",
          "name": "Abyssal Pane",
          "icon": "resources/mandala.svg"
        },
        {
          "id": "chthonic.themeView",
          "name": "Themes",
          "icon": "$(paintcan)"
        },
        {
          "id": "chthonic.statusView",
          "name": "Status",
          "icon": "$(pulse)"
        }
      ]
    },
    "configuration": {
      "title": "Chthonic Archive",
      "properties": {
        "chthonic.ssotPath": {
          "type": "string",
          "default": ".github/copilot-instructions.md",
          "description": "Path to the SSOT file (relative to workspace root)."
        },
        "chthonic.showSSOTHash": {
          "type": "boolean",
          "default": true,
          "description": "Show SSOT hash in status bar."
        },
        "chthonic.showLineage": {
          "type": "boolean",
          "default": true,
          "description": "Show active lineage indicator in status bar."
        },
        "chthonic.entropy.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable dynamic entropy analysis and explorer decay decoration overlay."
        },
        "chthonic.entropy.maxFiles": {
          "type": "number",
          "default": 10000,
          "minimum": 200,
          "description": "Maximum number of files scanned by the entropy worker."
        },
        "chthonic.entropy.scanIntervalMs": {
          "type": "number",
          "default": 20000,
          "minimum": 5000,
          "description": "Background entropy rescan interval in milliseconds."
        },
        "chthonic.entropy.decorationDebounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Debounce interval for FileDecorationProvider updates."
        },
        "chthonic.entropy.decorationBatchSize": {
          "type": "number",
          "default": 240,
          "minimum": 64,
          "description": "Maximum URI updates emitted per FileDecorationProvider flush."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --minify && bun build src/entropy/entropyWorker.ts --outfile dist/entropy-worker.js --target node --format cjs --minify",
    "watch": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --watch",
    "watch:worker": "bun build src/entropy/entropyWorker.ts --outfile dist/entropy-worker.js --target node --format cjs --watch"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.x"
  },
  "dependencies": {}
}

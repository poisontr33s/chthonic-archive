{
  "name": "TOML",
  "scopeName": "source.toml",
  "patterns": [
    { "include": "#comments" },
    { "include": "#tables" },
    { "include": "#keys" },
    { "include": "#strings" },
    { "include": "#datetimes" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.toml",
          "match": "#.*$"
        }
      ]
    },
    "tables": {
      "patterns": [
        {
          "name": "entity.name.section.array.toml",
          "match": "^\\s*(\\[\\[)\\s*([^\\]]+)\\s*(\\]\\])",
          "captures": {
            "1": { "name": "punctuation.definition.section.begin.toml" },
            "2": { "name": "entity.name.section.toml" },
            "3": { "name": "punctuation.definition.section.end.toml" }
          }
        },
        {
          "name": "entity.name.section.toml",
          "match": "^\\s*(\\[)\\s*([^\\]]+)\\s*(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.section.begin.toml" },
            "2": { "name": "entity.name.section.toml" },
            "3": { "name": "punctuation.definition.section.end.toml" }
          }
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "name": "variable.other.key.toml",
          "match": "(?x)\n            ^\\s*\n            (\n              \"(?:\\\\.|[^\"])*\"\n              |\n              '(?:[^']*)'\n              |\n              [A-Za-z0-9_-]+\n            )\n            (?:\n              \\s*\\.\\s*\n              (\n                \"(?:\\\\.|[^\"])*\"\n                |\n                '(?:[^']*)'\n                |\n                [A-Za-z0-9_-]+\n              )\n            )*\n            (?=\\s*=)\n          "
        },
        {
          "name": "keyword.operator.assignment.toml",
          "match": "="
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.multiline.toml",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.single.multiline.toml",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.toml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.toml",
              "match": "\\\\(?:[btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            }
          ]
        },
        {
          "name": "string.quoted.single.toml",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "datetimes": {
      "patterns": [
        {
          "name": "constant.numeric.datetime.toml",
          "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)?(?:[Zz]|[+-]\\d{2}:\\d{2})?\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.toml",
          "match": "\\b(?:[+-]?(?:0|[1-9](?:_?\\d)*)|0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0o[0-7](?:_?[0-7])*|0b[01](?:_?[01])*)(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d(?:_?\\d)*)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.toml",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.sequence.toml",
          "match": ","
        },
        {
          "name": "punctuation.definition.array.begin.toml",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.array.end.toml",
          "match": "\\]"
        },
        {
          "name": "punctuation.definition.inline-table.begin.toml",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.inline-table.end.toml",
          "match": "\\}"
        }
      ]
    }
  }
}

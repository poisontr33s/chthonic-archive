#version 450

layout(local_size_x = 256) in;

struct SedimentInput {
    float entropy;          // 0.0 - 1.0
    float change_frequency; // normalized commits touching this file / total commits
    float recency;          // 0.0 (ancient) to 1.0 (recent), exponential decay
    float author_diversity; // unique authors / total authors, normalized
    uint  file_index;       // deterministic placement seed
    uint  layer_depth;      // geological layer (0 = surface, N = deep)
    float complexity;       // from entropy worker
    float _padding;         // align to 32 bytes
};

struct SedimentVertex {
    float x;
    float y;
    float z;
    float radius;
    float r;
    float g;
    float b;
    float alpha;
};

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
    SedimentInput inputs[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer {
    SedimentVertex vertices[];
};

layout(push_constant) uniform PushConstants {
    uint total_files;
    float time_scale;
    float entropy_scale;
    float layer_gap;
};

// Golden angle spiral for even distribution on a disc
vec2 sunflower_position(uint index, uint total) {
    float golden_angle = 2.39996323; // pi * (3 - sqrt(5))
    float r = sqrt(float(index) / float(max(total, 1u)));
    float theta = float(index) * golden_angle;
    return vec2(r * cos(theta), r * sin(theta));
}

// Matches the Abyssal Pane palette: green -> gold -> brown
vec3 entropy_color(float entropy) {
    if (entropy >= 0.78) return vec3(0.541, 0.298, 0.165); // #8a4c2a brown
    if (entropy >= 0.48) return vec3(0.788, 0.663, 0.384); // #c9a962 gold
    return vec3(0.486, 0.682, 0.404);                       // #7cae67 green
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= total_files) return;

    SedimentInput inp = inputs[id];

    // XY: sunflower spiral within the layer, spread by recency
    vec2 xy = sunflower_position(inp.file_index, total_files);
    float spread = mix(0.3, 1.0, inp.recency);
    xy *= spread * 400.0;

    // Z: layer depth (negative = deeper) + entropy displacement
    float z = -float(inp.layer_depth) * layer_gap
              + inp.entropy * entropy_scale
              + inp.change_frequency * 20.0;

    // Radius: complexity + change frequency
    float radius = 2.0 + inp.complexity * 3.0 + inp.change_frequency * 2.0;

    // Color + alpha from author diversity
    vec3 color = entropy_color(inp.entropy);
    float alpha = mix(0.4, 1.0, inp.author_diversity);

    vertices[id] = SedimentVertex(
        xy.x, xy.y, z,
        radius,
        color.r, color.g, color.b,
        alpha
    );
}

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---------------------------------------------------------
// DATA STRUCTURES
// ---------------------------------------------------------

struct Node {
    vec4 position; // xyz = pos, w = mass (1.0 = heavy/old, 0.1 = light/new)
    vec4 velocity; // xyz = vel, w = entropy (0.0 to 1.0)
    vec4 color;    // rgba output for the renderer
};

// The Storage Buffer (Read/Write)
layout(std430, binding = 0) buffer NodeBuffer {
    Node nodes[];
};

// Uniforms (Push Constants)
layout(push_constant) uniform Constants {
    float delta_time;    // Time step (e.g., 0.016)
    float total_time;    // Total running time (for pulsing)
    uint node_count;     // Total number of commits/files
    float gravity_str;   // Strength of "Sinking" (-9.8ish)
    float repel_str;     // Strength of "Entropy Repulsion"
} u;

// ---------------------------------------------------------
// CONSTANTS & HELPERS
// ---------------------------------------------------------

const float GOLDEN_ANGLE = 2.39996323;
const float DECAY = 0.98; // Velocity damping (friction)

// Pseudo-random generator based on index
float hash(uint n) {
    n = (n << 13U) ^ n;
    n = n * (n * n * 15731U + 789221U) + 1376312589U;
    return float(n & 0x7fffffffU) / float(0x7fffffff);
}

// ---------------------------------------------------------
// MAIN
// ---------------------------------------------------------

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u.node_count) return;

    // Load State
    Node n = nodes[idx];
    vec3 pos = n.position.xyz;
    vec3 vel = n.velocity.xyz;

    float entropy = n.velocity.w; // Entropy stored in velocity.w
    float mass = n.position.w;    // Age/Mass stored in position.w

    // -----------------------------------------------------
    // FORCE 1: THE SEDIMENT SPIRAL (Target Position)
    // -----------------------------------------------------
    // Calculate the "Ideal" resting place based on the Golden Angle.
    // Older nodes (high index) act as the "Core".
    float r = sqrt(float(idx)) * 0.5;
    float theta = float(idx) * GOLDEN_ANGLE + (u.total_time * 0.05 * entropy);

    vec3 target_pos;
    target_pos.x = r * cos(theta);
    target_pos.z = r * sin(theta);

    // Depth (Y) is determined by Mass (Age).
    // Heavy sinks (-Y), High Entropy floats (+Y).
    target_pos.y = (-mass * 50.0) + (entropy * 20.0 * sin(u.total_time + float(idx)));

    // -----------------------------------------------------
    // FORCE 2: PHYSICS INTEGRATION (Spring force to Target)
    // -----------------------------------------------------
    vec3 to_target = target_pos - pos;
    vec3 force = to_target * 2.0; // Spring stiffness

    // Add "Brownian Motion" for high entropy nodes (Jitter)
    if (entropy > 0.8) {
        vec3 jitter = vec3(
            hash(idx + uint(u.total_time)) - 0.5,
            hash(idx + 1u + uint(u.total_time)) - 0.5,
            hash(idx + 2u + uint(u.total_time)) - 0.5
        );
        force += jitter * u.repel_str * 5.0;
    }

    // Apply Gravity (Global Downward Pressure)
    force.y += u.gravity_str * mass;

    // Update Velocity (Euler Integration)
    vel += force * u.delta_time;
    vel *= DECAY; // Friction

    // Update Position
    pos += vel * u.delta_time;

    // -----------------------------------------------------
    // VISUALIZATION (Color Mapping)
    // -----------------------------------------------------
    // Map Entropy to Heat Color (Void -> Gold bioluminescence)
    vec3 color_base = vec3(0.05, 0.05, 0.05); // Void (Low Entropy)
    vec3 color_hot = vec3(0.96, 0.77, 0.19);  // Gold (High Entropy)

    // "Bioluminescence" pulse
    float pulse = 0.8 + 0.2 * sin(u.total_time * 3.0 + float(idx));
    vec3 final_color = mix(color_base, color_hot, entropy) * pulse;

    // Store State
    nodes[idx].position = vec4(pos, mass);
    nodes[idx].velocity = vec4(vel, entropy);
    nodes[idx].color = vec4(final_color, 1.0);
}

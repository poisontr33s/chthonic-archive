  "tokenColors": [
    {
      "name": "Comments (Soot)",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"],
      "settings": { "foreground": "#908672", "fontStyle": "italic" }
    },
    {
      "name": "Strings (Worn Parchment)",
      "scope": ["string", "string.quoted", "constant.character"],
      "settings": { "foreground": "#B9A37A" }
    },
    {
      "name": "Numbers (Molten Amber)",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#D7B562" }
    },
    {
      "name": "Language Constants (Heated Copper)",
      "scope": ["constant.language"],
      "settings": { "foreground": "#D4907A" }
    },
    {
      "name": "Keywords (Hot Iron)",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#D4714E", "fontStyle": "bold" }
    },
    {
      "name": "Functions (Forge Amber)",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#D7B562" }
    },
    {
      "name": "Classes/Types (Heated Copper)",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#D4907A", "fontStyle": "bold" }
    },
    {
      "name": "Constants/Namespaces (Quenched Steel)",
      "scope": ["constant", "variable.other.constant", "entity.name.namespace", "support.constant"],
      "settings": { "foreground": "#7AAAB2" }
    },
    {
      "name": "Variables (Iron Dust)",
      "scope": ["variable", "variable.parameter", "variable.language", "variable.other"],
      "settings": { "foreground": "#E8E2D2" }
    },
    {
      "name": "Operators (Slag Neutral)",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#B0A896" }
    },
    {
      "name": "Decorators (Forge Gold)",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#F4C430", "fontStyle": "bold italic" }
    },
    {
      "name": "Tags (Heated Copper)",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"],
      "settings": { "foreground": "#D4907A", "fontStyle": "bold" }
    },
    {
      "name": "Attributes (Forge Gold)",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#F4C430" }
    },
    {
      "name": "Markup Heading/Bold (Forge Gold)",
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#F4C430", "fontStyle": "bold" }
    },
    {
      "name": "Markup Italic (Quenched Steel)",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#7AAAB2", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code (Parchment)",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.fenced_code.block"],
      "settings": { "foreground": "#B9A37A" }
    },
    {
      "name": "Links (Bright Steel)",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8CBEC6", "fontStyle": "underline" }
    },
    {
      "name": "JSON Keys (Forge Amber)",
      "scope": ["support.type.property-name.json", "meta.object-literal.key"],
      "settings": { "foreground": "#D7B562" }
    },
    {
      "name": "Invalid (Hot Iron Red)",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": { "foreground": "#E05545", "fontStyle": "strikethrough" }
    },
    {
      "name": "Rust Lifetimes (Ember Rose)",
      "scope": ["storage.modifier.lifetime.rust", "entity.name.type.lifetime"],
      "settings": { "foreground": "#C87060", "fontStyle": "italic" }
    },
    {
      "name": "Rust Macros (Forge Gold)",
      "scope": ["entity.name.function.macro.rust", "support.function.macro.rust"],
      "settings": { "foreground": "#F4C430", "fontStyle": "bold" }
    },
    {
      "name": "Python Decorators (Forge Gold)",
      "scope": ["meta.function.decorator.python", "entity.name.function.decorator.python"],
      "settings": { "foreground": "#F4C430", "fontStyle": "bold italic" }
    },
    {
      "name": "TSX Components (Heated Copper)",
      "scope": ["entity.name.tag.tsx", "support.class.component.tsx"],
      "settings": { "foreground": "#D4907A" }
    },
    {
      "name": "This/Self (Ember)",
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#C87060", "fontStyle": "italic" }
    },
    {
      "name": "Import/Export (Quenched Steel)",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": { "foreground": "#7AAAB2" }
    },
    {
      "name": "Template Literals (Parchment)",
      "scope": ["string.template", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#B9A37A" }
    }
  ]
}

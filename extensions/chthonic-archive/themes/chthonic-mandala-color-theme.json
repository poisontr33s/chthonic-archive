    "statusBar.debuggingBackground": "#D06060",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#5E9E94",

    "editorLineNumber.foreground": "#8B7B72",
    "editorLineNumber.activeForeground": "#C9A962",
    "editorCursor.foreground": "#C9A962",
    "editor.selectionBackground": "#4A382880",
    "editor.selectionHighlightBackground": "#3D2C2260",
    "editor.lineHighlightBackground": "#1E161280",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#352A22",

    "editorBracketMatch.background": "#C9A96230",
    "editorBracketMatch.border": "#C9A962",
    "editorIndentGuide.background1": "#2D221E",
    "editorIndentGuide.activeBackground1": "#5A4D44",

    "editorError.foreground": "#D06060",
    "editorWarning.foreground": "#C9A55A",
    "editorInfo.foreground": "#6B9E94",
    "editorHint.foreground": "#A8C686",

    "editorGutter.addedBackground": "#A8C68660",
    "editorGutter.modifiedBackground": "#C9A55A60",
    "editorGutter.deletedBackground": "#D0606060",

    "diffEditor.insertedTextBackground": "#A8C68618",
    "diffEditor.removedTextBackground": "#D0606018",

    "terminal.background": "#110D0A",
    "terminal.foreground": "#E8DDD4",
    "terminal.ansiBlack": "#2D221E",
    "terminal.ansiRed": "#D06060",
    "terminal.ansiGreen": "#A8C686",
    "terminal.ansiYellow": "#C9A55A",
    "terminal.ansiBlue": "#7BAEA4",
    "terminal.ansiMagenta": "#D4A5A5",
    "terminal.ansiCyan": "#6EAEA4",
    "terminal.ansiWhite": "#E8DDD4",
    "terminal.ansiBrightBlack": "#8B7B72",
    "terminal.ansiBrightRed": "#D88080",
    "terminal.ansiBrightGreen": "#B8D696",
    "terminal.ansiBrightYellow": "#D9B56A",
    "terminal.ansiBrightBlue": "#8BBEB4",
    "terminal.ansiBrightMagenta": "#E4B5B5",
    "terminal.ansiBrightCyan": "#7EBEB4",
    "terminal.ansiBrightWhite": "#F8EDE4",

    "tab.activeBackground": "#1A1412",
    "tab.activeForeground": "#C9A962",
    "tab.activeBorder": "#C9A962",
    "tab.inactiveBackground": "#110D0A",
    "tab.inactiveForeground": "#9B8B80",
    "tab.border": "#1A1412",
    "tab.hoverBackground": "#1A141280",
    "tab.hoverForeground": "#D4A5A5",

    "titleBar.activeBackground": "#0E0B09",
    "titleBar.activeForeground": "#C9A962",
    "titleBar.inactiveBackground": "#110D0A",
    "titleBar.inactiveForeground": "#8B7B72",
    "titleBar.border": "#3D2E2880",

    "panel.background": "#171210",
    "panel.border": "#1A1412",
    "panelTitle.activeBorder": "#C9A962",
    "panelTitle.activeForeground": "#C9A962",
    "panelTitle.inactiveForeground": "#9B8B80",

    "list.activeSelectionBackground": "#3D2E28",
    "list.activeSelectionForeground": "#C9A962",
    "list.hoverBackground": "#2D221E",
    "list.hoverForeground": "#D4A5A5",
    "list.inactiveSelectionBackground": "#1A1412",
    "list.inactiveSelectionForeground": "#C4B8B0",
    "list.focusBackground": "#3D2E28",
    "list.focusForeground": "#C9A962",
    "list.highlightForeground": "#C9A962",

    "button.background": "#D4A5A5",
    "button.foreground": "#0E0B09",
    "button.hoverBackground": "#E4B5B5",
    "input.background": "#1A1412",
    "input.border": "#3D2E28",
    "input.foreground": "#E8DDD4",
    "inputOption.activeBorder": "#C9A962",
    "dropdown.background": "#1A1412",
    "dropdown.border": "#3D2E28",

    "badge.background": "#C87070",
    "badge.foreground": "#FFFFFF",

    "progressBar.background": "#C9A962",

    "debugToolBar.background": "#201916",
    "toolbar.hoverBackground": "#2D221E",

    "notificationCenter.border": "#C9A962",
    "notificationCenterHeader.background": "#1A1412",
    "notificationCenterHeader.foreground": "#C9A962",
    "notificationToast.border": "#C9A962",
    "notifications.background": "#1A1412",
    "notifications.border": "#C9A962",
    "notifications.foreground": "#E8DDD4",
    "notificationLink.foreground": "#7BAEA4",

    "gitDecoration.modifiedResourceForeground": "#C9A55A",
    "gitDecoration.deletedResourceForeground": "#D06060",
    "gitDecoration.untrackedResourceForeground": "#A8C686",
    "gitDecoration.ignoredResourceForeground": "#6B5D54",
    "gitDecoration.conflictingResourceForeground": "#C87070",
    "gitDecoration.stageModifiedResourceForeground": "#6B9E94",
    "gitDecoration.stageDeletedResourceForeground": "#C87070",

    "merge.currentHeaderBackground": "#6B9E9460",
    "merge.currentContentBackground": "#6B9E9420",
    "merge.incomingHeaderBackground": "#D4A5A560",
    "merge.incomingContentBackground": "#D4A5A520",

    "peekView.border": "#C9A962",
    "peekViewEditor.background": "#1A1412",
    "peekViewEditorGutter.background": "#171210",
    "peekViewResult.background": "#171210",
    "peekViewTitle.background": "#0E0B09",
    "peekViewTitleLabel.foreground": "#C9A962",

    "breadcrumb.foreground": "#9B8B80",
    "breadcrumb.background": "#110D0A",
    "breadcrumb.focusForeground": "#C9A962",
    "breadcrumb.activeSelectionForeground": "#C9A962",
    "breadcrumbPicker.background": "#1A1412",

    "scrollbar.shadow": "#00000080",
    "scrollbarSlider.background": "#3D2E2880",
    "scrollbarSlider.hoverBackground": "#4A3D3880",
    "scrollbarSlider.activeBackground": "#5A4D4880",

    "minimap.errorHighlight": "#D0606080",
    "minimap.warningHighlight": "#C9A55A80",
    "minimap.selectionHighlight": "#C9A96240",
    "minimap.findMatchHighlight": "#C9A96240",

    "charts.red": "#D06060",
    "charts.orange": "#C9A55A",
    "charts.yellow": "#D9B56A",
    "charts.green": "#A8C686",
    "charts.blue": "#7BAEA4",
    "charts.purple": "#D4A5A5",
    "charts.foreground": "#E8DDD4",
    "charts.lines": "#4A3D38"
  },
  "tokenColors": [
    {
      "name": "Comments (Warm Gray - Readable)",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"],
      "settings": { "foreground": "#9B8B82", "fontStyle": "italic" }
    },
    {
      "name": "Strings (Sage Green)",
      "scope": ["string", "string.quoted", "constant.character"],
      "settings": { "foreground": "#A8C686" }
    },
    {
      "name": "Numbers (Warm Amber)",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#D4B59A" }
    },
    {
      "name": "Language Constants (Flesh Rose)",
      "scope": ["constant.language"],
      "settings": { "foreground": "#D4A5A5" }
    },
    {
      "name": "Keywords (Earthy Red)",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#C75D5D", "fontStyle": "bold" }
    },
    {
      "name": "Functions (Warm Gold)",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#C9A55A" }
    },
    {
      "name": "Classes/Types (Flesh Rose)",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#D4A5A5", "fontStyle": "bold" }
    },
    {
      "name": "Constants/Namespaces (Sacred Teal)",
      "scope": ["constant", "variable.other.constant", "entity.name.namespace", "support.constant"],
      "settings": { "foreground": "#6B9E94" }
    },
    {
      "name": "Variables (Warm Cream)",
      "scope": ["variable", "variable.parameter", "variable.language", "variable.other"],
      "settings": { "foreground": "#E8DDD4" }
    },
    {
      "name": "Operators (Warm Neutral)",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#B8A89E" }
    },
    {
      "name": "Decorators (Supreme Gold)",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#C9A962", "fontStyle": "bold italic" }
    },
    {
      "name": "Tags (Flesh Rose)",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"],
      "settings": { "foreground": "#D4A5A5", "fontStyle": "bold" }
    },
    {
      "name": "Attributes (Decorator Gold)",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#C9A962" }
    },
    {
      "name": "Markup Heading/Bold (Gold)",
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#C9A962", "fontStyle": "bold" }
    },
    {
      "name": "Markup Italic (Teal)",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#6B9E94", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code (Sage)",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.fenced_code.block"],
      "settings": { "foreground": "#A8C686" }
    },
    {
      "name": "Links (Bright Teal)",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#7BAEA4", "fontStyle": "underline" }
    },
    {
      "name": "JSON Keys (Warm Gold)",
      "scope": ["support.type.property-name.json", "meta.object-literal.key"],
      "settings": { "foreground": "#C9A55A" }
    },
    {
      "name": "Invalid (Blood Red)",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": { "foreground": "#D06060", "fontStyle": "strikethrough" }
    },
    {
      "name": "Rust Lifetimes (Muted Rose)",
      "scope": ["storage.modifier.lifetime.rust", "entity.name.type.lifetime"],
      "settings": { "foreground": "#C87070", "fontStyle": "italic" }
    },
    {
      "name": "Rust Macros (Gold)",
      "scope": ["entity.name.function.macro.rust", "support.function.macro.rust"],
      "settings": { "foreground": "#C9A962", "fontStyle": "bold" }
    },
    {
      "name": "Python Decorators (Gold)",
      "scope": ["meta.function.decorator.python", "entity.name.function.decorator.python"],
      "settings": { "foreground": "#C9A962", "fontStyle": "bold italic" }
    },
    {
      "name": "TSX Components (Flesh Rose)",
      "scope": ["entity.name.tag.tsx", "support.class.component.tsx"],
      "settings": { "foreground": "#D4A5A5" }
    },
    {
      "name": "This/Self (Transgressive Rose)",
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#C87070", "fontStyle": "italic" }
    },
    {
      "name": "Import/Export (Sacred Teal)",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": { "foreground": "#6B9E94" }
    },
    {
      "name": "Template Literals (Sage)",
      "scope": ["string.template", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#A8C686" }
    }
  ]
}
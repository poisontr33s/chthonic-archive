{
  "name": "chtonic-rendered-ai-markdown-paste-flavoured",
  "displayName": "Chtonic Rendered AI Markdown Paste Flavoured",
  "description": "Chthonic Archive flavoured paste provider that converts rendered AI HTML clipboard content into Markdown.",
  "version": "0.1.0",
  "publisher": "chthonic-archive",
  "private": true,
  "icon": "icons/mandala.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chthonic-archive/chthonic-archive"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:renderedAiMarkdownPaste.pasteAsMarkdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "renderedAiMarkdownPaste.pasteAsMarkdown",
        "title": "Rendered AI Markdown Paste: Paste as Markdown",
        "icon": "$(markdown)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "renderedAiMarkdownPaste.pasteAsMarkdown",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "bunx tsc -p .",
    "compile": "bun run typecheck && bun build src/extension.ts --outfile dist/extension.js --target node --format cjs --external vscode",
    "test": "bun run compile && bun test src/convert.fixture.test.ts",
    "insiders:run": "code-insiders --extensionDevelopmentPath=.",
    "insiders:package": "bunx @vscode/vsce package --pre-release --no-dependencies --out chtonic-rendered-ai-markdown-paste-flavoured-insiders.vsix --skip-license"
  },
  "dependencies": {
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/turndown": "5.0.6",
    "@types/vscode": "1.110.0",
    "typescript": "5.9.3"
  }
}

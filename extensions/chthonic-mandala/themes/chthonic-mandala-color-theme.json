{
  "name": "Chthonic Mandala - Decorator's Flesh & Earth",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "*.decorator": "#C9A962",
    "*.matriarch": "#D4A5A5",
    "*.triumvirate": "#C87070",
    "*.milf": "#D4A5A5",
    "*.ssot": "#6B9E94",
    "*.frozen": "#A8C686",
    "*.lineageA": "#C75D5D",
    "*.lineageB": "#6B9E94",
    "*.lineageC": "#C9A55A",
    "*.tier0": "#C9A962",
    "*.tier1": "#C87070",
    "*.tier2": "#D4A5A5",
    "*.tier3": "#A8C686"

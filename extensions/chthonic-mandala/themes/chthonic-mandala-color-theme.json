    "gitDecoration.modifiedResourceForeground": "#C9A55A",
    "gitDecoration.deletedResourceForeground": "#B35050",
    "gitDecoration.untrackedResourceForeground": "#A8C686",
    "gitDecoration.ignoredResourceForeground": "#4A3D38",
    "gitDecoration.conflictingResourceForeground": "#C87070",
    "gitDecoration.stageModifiedResourceForeground": "#6B9E94",
    "gitDecoration.stageDeletedResourceForeground": "#C87070",

    "merge.currentHeaderBackground": "#6B9E9460",
    "merge.currentContentBackground": "#6B9E9420",
    "merge.incomingHeaderBackground": "#D4A5A560",
    "merge.incomingContentBackground": "#D4A5A520",

    "peekView.border": "#C9A962",
    "peekViewEditor.background": "#1A1412",
    "peekViewEditorGutter.background": "#171210",

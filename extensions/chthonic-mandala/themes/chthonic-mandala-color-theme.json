    "statusBar.debuggingBackground": "#B35050",
    "statusBar.debuggingForeground": "#E8DDD4",
    "statusBar.noFolderBackground": "#5E9E94",

    "editorLineNumber.foreground": "#4A3D38",
    "editorLineNumber.activeForeground": "#C9A962",
    "editorCursor.foreground": "#C9A962",
    "editor.selectionBackground": "#3D2E28",
    "editor.selectionHighlightBackground": "#2D221E",
    "editor.lineHighlightBackground": "#1A141280",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#2D221E",

    "editorBracketMatch.background": "#C9A96220",

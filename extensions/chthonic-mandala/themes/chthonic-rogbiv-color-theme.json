  "tokenColors": [
    {
      "name": "Comments (Muted Lavender)",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"],
      "settings": { "foreground": "#8A89A0", "fontStyle": "italic" }
    },
    {
      "name": "Strings (Orange)",
      "scope": ["string", "string.quoted", "constant.character"],
      "settings": { "foreground": "#FFB84D" }
    },
    {
      "name": "Numbers (Red)",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "name": "Language Constants (Bright Red)",
      "scope": ["constant.language"],
      "settings": { "foreground": "#FF8A8A" }
    },
    {
      "name": "Keywords (Teal)",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#4ECDC4", "fontStyle": "bold" }
    },
    {
      "name": "Functions (Gold)",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "Classes/Types (White)",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#B8B8CC", "fontStyle": "bold" }
    },
    {
      "name": "Constants/Namespaces (Violet)",
      "scope": ["constant", "variable.other.constant", "entity.name.namespace", "support.constant"],
      "settings": { "foreground": "#9B7ACC" }
    },
    {
      "name": "Variables (Foreground)",
      "scope": ["variable", "variable.parameter", "variable.language", "variable.other"],
      "settings": { "foreground": "#DADAE6" }
    },
    {
      "name": "Operators (Muted Lavender)",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#B8B8CC" }
    },
    {
      "name": "Decorators (White)",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#B8B8CC", "fontStyle": "bold italic" }
    },
    {
      "name": "Tags (Gold)",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"],
      "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
    },
    {
      "name": "Attributes (Orange)",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FFB84D" }
    },
    {
      "name": "Markup Heading/Bold (Gold)",
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
    },
    {
      "name": "Markup Italic (Teal)",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#4ECDC4", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code (Orange)",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.fenced_code.block"],
      "settings": { "foreground": "#FFB84D" }
    },
    {
      "name": "Links (Teal)",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#4ECDC4", "fontStyle": "underline" }
    },
    {
      "name": "JSON Keys (Gold)",
      "scope": ["support.type.property-name.json", "meta.object-literal.key"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "Invalid (Red)",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": { "foreground": "#FF6B6B", "fontStyle": "strikethrough" }
    },
    {
      "name": "Rust Lifetimes (Violet)",
      "scope": ["storage.modifier.lifetime.rust", "entity.name.type.lifetime"],
      "settings": { "foreground": "#9B7ACC", "fontStyle": "italic" }
    },
    {
      "name": "Rust Macros (Gold)",
      "scope": ["entity.name.function.macro.rust", "support.function.macro.rust"],
      "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
    },
    {
      "name": "Python Decorators (White)",
      "scope": ["meta.function.decorator.python", "entity.name.function.decorator.python"],
      "settings": { "foreground": "#B8B8CC", "fontStyle": "bold italic" }
    },
    {
      "name": "TSX Components (Warm Rose)",
      "scope": ["entity.name.tag.tsx", "support.class.component.tsx"],
      "settings": { "foreground": "#D4A5C8" }
    },
    {
      "name": "This/Self (Red)",
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#FF6B6B", "fontStyle": "italic" }
    },
    {
      "name": "Import/Export (Teal)",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": { "foreground": "#4ECDC4" }
    },
    {
      "name": "Template Literals (Orange)",
      "scope": ["string.template", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#FFB84D" }
    }
  ]
}

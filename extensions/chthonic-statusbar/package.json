{
  "name": "chthonic-statusbar",
  "displayName": "Chthonic Status Bridge",
  "description": "Compatibility bridge that routes legacy statusbar commands into chthonic-archive runtime lanes",
  "version": "0.2.0",
  "publisher": "chthonic-archive",
  "repository": {
    "type": "git",
    "url": "https://github.com/chthonic-archive/chthonic-archive"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "sideEffects": false,
  "bun": {
    "treeShaking": true,
    "minify": true,
    "define": {
      "process.env.NODE_ENV": "\"production\""
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "chthonic.bridge.verifySSOT",
        "title": "Chthonic Bridge: Verify SSOT",
        "icon": "$(shield)"
      },
      {
        "command": "chthonic.bridge.selfHeal",
        "title": "Chthonic Bridge: Self-Heal",
        "icon": "$(wrench)"
      },
      {
        "command": "chthonic.bridge.sediment",
        "title": "Chthonic Bridge: Sediment Layers",
        "icon": "$(layers)"
      },
      {
        "command": "chthonic.bridge.verifyHost",
        "title": "Chthonic Bridge: Verify Host",
        "icon": "$(check)"
      },
      {
        "command": "chthonic.bridge.vsAudit",
        "title": "Chthonic Bridge: VS 2026 Audit",
        "icon": "$(tools)"
      },
      {
        "command": "chthonic.bridge.webCockpit",
        "title": "Chthonic Bridge: Web Cockpit",
        "icon": "$(globe)"
      },
      {
        "command": "chthonic.bridge.bunDocs",
        "title": "Chthonic Bridge: Bun Docs",
        "icon": "$(book)"
      },
      {
        "command": "chthonic.verifySSO_T",
        "title": "Chthonic: Verify SSOT (Legacy)"
      },
      {
        "command": "chthonic.runMetabolicCycle",
        "title": "Chthonic: Self-Heal (Legacy)"
      },
      {
        "command": "chthonic.showGPUStats",
        "title": "Chthonic: Sediment (Legacy)"
      },
      {
        "command": "chthonic.runHostVerify",
        "title": "Chthonic: Verify Host (Legacy)"
      },
      {
        "command": "chthonic.runVsAudit",
        "title": "Chthonic: VS Audit (Legacy)"
      },
      {
        "command": "chthonic.openWebCockpitBridge",
        "title": "Chthonic: Web Cockpit (Legacy)"
      },
      {
        "command": "chthonic.openBunTrainingDocsBridge",
        "title": "Chthonic: Bun Docs (Legacy)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --minify",
    "watch": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --watch",
    "insiders:kits:check": "bunx @vscode/vsce --version && bunx vscode-test-web --help",
    "_folded_into_chthonic_archive": "Statusbar is folded into chthonic-archive as the statusbar lane (src/statusbar/register.ts). De-packaged: insiders:package renamed inert below so the discovery lane no longer builds/installs it standalone (it would collide on chthonic.bridge.*). Source kept as seed (no-delete).",
    "insiders:package:folded": "bunx @vscode/vsce package --pre-release --no-dependencies --out chthonic-statusbar-insiders.vsix",
    "insiders:run": "code-insiders --extensionDevelopmentPath=.",
    "insiders:dts:sync": "bunx @vscode/dts dev && bunx @vscode/dts main"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@vscode/dts": "^0.4.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
